+"""Compile the actual callback clock helpers; no copied implementation."""
+from pathlib import Path
+import shutil,subprocess
+
+def function(text,name):
+ start=text.index('bool '+name+'(');end=text.index('{',start);depth=1;n=end+1
+ while depth:
+  depth+=(text[n]=='{')-(text[n]=='}');n+=1
+ return text[start:n]
+
+def test_callback_source_clock_and_deadline(tmp_path):
+ sdk=Path(__file__).resolve().parents[1]
+ text=(sdk/'runner/src/snes/interp_bridge.c').read_text(encoding='utf-8')
+ actual='\n'.join(function(text,n)for n in ['interp_bridge_source_opcode_available','interp_bridge_source_opcode_deadline_reached','interp_bridge_commit_source_opcode'])
+ harness=r"""
+#include <stdint.h>
+#include <stdbool.h>
+static struct {uint64_t source_native_opcodes,interrupt_native_opcodes;} s_native_only_bridge_stats;
+#include <assert.h>
+#include <stdio.h>
+typedef struct {uint64_t master_cycles,coprocessor_master_cycles;} CpuState;
+static CpuState g_cpu,foreign;
+static struct {void*apu;void*cart;} machine,*g_snes=&machine;
+static const CpuState*s_pre_opcode_callback_cpu;
+static int s_pre_opcode_callback_can_yield,s_pre_opcode_callback_auto_quiescent;
+static uint64_t s_lle_master_deadline,s_apu_pending_master,g_interp_bridge_write_epoch;
+static uint64_t *s_pre_opcode_callback_progress_epoch;
+static uint64_t epoch,anchor,tax;static int extended,frame,sa1,absolute,flushes,syncs,copro_syncs;
+static int rtl_apu_extended_frame_timing(void){return extended;}
+static int rtl_apu_frame_timeline_active(void){return frame;}
+static int cart_has_sa1(void*c){return c&&sa1;}
+static int interp_bridge_use_absolute_apu_timeline(int f,int s,int m){return f&&(s||m);}
+static int rtl_apu_absolute_periodic_enabled(void){return absolute;}
+static void snes_refresh_charge(void){g_cpu.master_cycles+=tax;}
+static void snes_sync_master_clock(void*s,uint64_t clock){assert(s==g_snes&&clock==g_cpu.master_cycles);syncs++;}
+static void cart_sync_coprocessors(void*c,uint64_t clock){assert(c==g_snes->cart&&clock==g_cpu.master_cycles);copro_syncs++;}
+static int bridge_periodic_apu_flush_due(const CpuState*c){return absolute?c->master_cycles>=anchor&&c->master_cycles-anchor>=1024:s_apu_pending_master>=1024;}
+static void bridge_apu_flush(CpuState*c){if(s_apu_pending_master){flushes++;s_apu_pending_master=0;anchor=c->master_cycles;}}
+"""+actual+r"""
+static void reset(void){g_cpu=(CpuState){2050,99};foreign=g_cpu;g_snes=&machine;machine.apu=(void*)1;machine.cart=(void*)1;s_pre_opcode_callback_cpu=&g_cpu;s_pre_opcode_callback_can_yield=1;s_pre_opcode_callback_auto_quiescent=1;s_lle_master_deadline=5000;s_apu_pending_master=0;g_interp_bridge_write_epoch=epoch=7;s_pre_opcode_callback_progress_epoch=&epoch;anchor=1000;tax=0;extended=frame=sa1=absolute=flushes=syncs=copro_syncs=0;}
+int main(void){
+ for(unsigned mask=0;mask<256;mask++){
+  reset();absolute=mask&1;extended=!!(mask&2);s_pre_opcode_callback_auto_quiescent=!!(mask&4);int wrote=!!(mask&8);s_apu_pending_master=mask&16?1000:10;sa1=!!(mask&32);tax=mask&64?40:0;frame=!!(mask&128);
+  uint64_t expected=s_apu_pending_master;int add=extended||!frame||!sa1;int flushed=0;
+  if(add){expected+=50;if((absolute?(2050+tax-1000>=1024):expected>=1024)&&expected){expected=0;flushed++;}}
+  if(wrote&&s_pre_opcode_callback_auto_quiescent&&!absolute&&expected){expected=0;flushed++;}
+  assert(interp_bridge_source_opcode_available(&g_cpu));assert(!interp_bridge_source_opcode_deadline_reached(&g_cpu));
+  assert(interp_bridge_commit_source_opcode(&g_cpu,2000,wrote));assert(g_cpu.master_cycles==2050+tax&&g_cpu.coprocessor_master_cycles==2050+tax);assert(s_apu_pending_master==expected&&flushes==flushed&&syncs==1&&copro_syncs==1);assert(g_interp_bridge_write_epoch==7u+wrote&&epoch==7u+wrote);
+ }
+ for(unsigned n=0;n<9;n++){
+  reset();CpuState*c=&g_cpu;if(n==0)c=NULL;if(n==1)c=&foreign;if(n==2)s_pre_opcode_callback_cpu=NULL;if(n==3)s_pre_opcode_callback_can_yield=0;if(n==4)s_lle_master_deadline=0;if(n==5)machine.apu=NULL;if(n==6)g_snes=NULL;if(n==7)g_cpu.master_cycles=1999;if(n==8)s_pre_opcode_callback_cpu=&foreign;
+  CpuState old=g_cpu;assert(!interp_bridge_commit_source_opcode(c,2000,true));assert(g_cpu.master_cycles==old.master_cycles&&g_cpu.coprocessor_master_cycles==old.coprocessor_master_cycles&&g_interp_bridge_write_epoch==7&&epoch==7&&!syncs&&!flushes);
+ }
+ reset();g_cpu.master_cycles=5000;assert(interp_bridge_source_opcode_deadline_reached(&g_cpu));s_pre_opcode_callback_cpu=NULL;assert(!interp_bridge_source_opcode_deadline_reached(&g_cpu));
+ puts("PASS 256 clock/cadence/write-epoch cases,9 immutable refusals and callback-scoped deadlines");return 0;
+}
+"""
+ source=tmp_path/'source_clock.c';source.write_text(harness,encoding='utf-8');exe=tmp_path/'source-clock.exe'
+ subprocess.run([shutil.which('clang')or'cc','-std=c11','-O2',str(source),'-o',str(exe)],check=True)
+ result=subprocess.run([str(exe)],check=True,capture_output=True,text=True);assert 'PASS 256' in result.stdout
+ # Callback authority is established only around the synchronized hook and restored.
+ assert 's_pre_opcode_callback_can_yield = auto_quiescent || s_lle_sched_depth > 0;' in text
+ assert 's_pre_opcode_callback_progress_epoch = &progress_write_epoch;' in text
+ assert 's_pre_opcode_callback_cpu = saved_callback_cpu;' in text
+ assert 's_pre_opcode_callback_progress_epoch = saved_callback_progress;' in text
