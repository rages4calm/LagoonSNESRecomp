+static int rtl_apu_extended_frame_timing(void){return 0;}static int rtl_apu_frame_timeline_active(void){return 0;}static int cart_has_sa1(void*c){(void)c;return 0;}static int interp_bridge_use_absolute_apu_timeline(int a,int b,int c){return a||b||c;}static int rtl_apu_absolute_periodic_enabled(void){return absolute;}
+static void snes_refresh_charge(void){}static void snes_sync_master_clock(void*s,uint64_t t){assert(s==g_snes&&t==150);}static void cart_sync_coprocessors(void*c,uint64_t t){assert(c==machine.cart&&t==150);}static int bridge_periodic_apu_flush_due(const CpuState*c){(void)c;return 0;}static void bridge_apu_flush(CpuState*c){(void)c;flushes++;s_apu_pending_master=0;}
+"""+actual+r"""
+static void setup(unsigned mask){memset(addresses,0,sizeof addresses);memset(values,0,sizeof values);g_cpu=(CpuState){100,100};g_snes=&machine;machine.apu=(void*)1;machine.cart=(void*)1;s_pre_opcode_callback_cpu=&g_cpu;s_pre_opcode_callback_can_yield=1;s_pre_opcode_callback_auto_quiescent=!!(mask&1);absolute=!!(mask&2);s_interp_bus_timing_active=!!(mask&4);claimed=!!(mask&8);s_lle_master_deadline=1000;s_apu_pending_master=120;g_interp_bridge_write_epoch=epoch=7;s_pre_opcode_callback_progress_epoch=&epoch;calls=word_reads=word_writes=flushes=0;}
+int main(void){unsigned cases=0;
+for(unsigned mask=0;mask<16;mask++)for(unsigned op=0;op<3;op++)for(unsigned value=0;value<16;value++){
+ setup(mask);uint16_t out=0;unsigned writes=0;
+ if(op==0){assert(interp_bridge_source_read16(&g_cpu,0x122140,0x122141,&out));assert(word_reads==1&&calls==2&&out==(claimed?0xbbaa:0x4140));}
+ if(op==1){assert(interp_bridge_source_write8(&g_cpu,0x122140,value));writes=1;assert(calls==1&&values[0]==value);}
