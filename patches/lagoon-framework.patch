new file mode 100644
index 0000000..4514bfa
--- /dev/null
+++ b/tests/v2/test_dispatch_helper_stack_consumption.py
@@ -0,0 +1,65 @@
+"""Inline table authority requires net caller-frame consumption in every width."""
+from _helpers import make_lorom_bank0
+from v2.decoder import classify_dispatch_helper
+from test_dispatcher_phk_per_jml import EXECUTE_PTR_BYTES
+
+
+def classify(body):
+    return classify_dispatch_helper(make_lorom_bank0({0x8000: bytes(body)}), 0, 0x8000)
+
+
+SHORT = [0x0A, 0xAA, 0x6C, 0x34, 0x12]  # ASL; TAX; JMP ($1234)
+
+
+def test_balanced_register_saves_are_not_inline_dispatch():
+    for push, pull in [(0x48, 0x68), (0xDA, 0xFA), (0x5A, 0x7A)]:
+        assert classify([push, 0x0A, 0xA8, pull, 0x6C, 0x34, 0x12]) is None
+    # A normal resident table selector with a balanced saved index register.
+    assert classify([0xAD, 0x10, 0x04, 0x5A, 0x0A, 0xA8,
+                     0xB9, 0x00, 0x90, 0x85, 0x20,
+                     0xB9, 0x01, 0x90, 0x85, 0x21,
+                     0x7A, 0x6C, 0x20, 0x00]) is None
+
+
+def test_all_entry_widths_must_consume_caller_bytes():
+    # M1/X1 alone looks consuming; M1/X0 is balanced after SEP changes X.
+    assert classify([0x5A, 0xE2, 0x10, 0x7A, 0x68] + SHORT) is None
+    # REP makes the pull two bytes: positive only for an initial eight-bit A.
+    assert classify([0x48, 0xC2, 0x20, 0x68] + SHORT) is None
+    assert classify([0xC2, 0x10, 0x5A, 0xE2, 0x10, 0x7A] + SHORT) is None
+
+
+def test_return_consumers_and_canonical_short_long_remain_recognized():
+    assert classify([0x68, 0x68, 0x68, 0x5A, 0x0A, 0xA8,
+                     0x7A, 0xDC, 0x20, 0x00]) == 'short'
+    assert classify(EXECUTE_PTR_BYTES) == 'short'
+    long_body = list(EXECUTE_PTR_BYTES)
+    long_body[long_body.index(0xA8):long_body.index(0xA8)] = [0x65, 0x10]
+    assert classify(long_body) == 'long'
+
+
+def test_fixed_width_stack_effects_do_not_cancel_return_consumption():
+    for balanced in ([0x8B, 0xAB], [0x4B, 0xAB], [0x0B, 0x2B],
+                     [0xF4, 0x34, 0x12, 0x2B],
+                     [0xD4, 0x10, 0x2B], [0x62, 0, 0, 0x2B]):
+        assert classify(list(balanced) + [0x68, 0x68, 0x68] + SHORT) == 'short'
+    # One-byte pushes must be counted too; three PLAs at M1 leave no consumption.
+    assert classify([0x08, 0x8B, 0x4B, 0x68, 0x68, 0x68] + SHORT) is None
+
+
+def test_untrackable_stack_or_mode_changes_refuse_inline_authority():
+    for unknown in ([0x1B], [0x9A], [0xFB], [0x28],
+                    [0x20, 0, 0x90], [0x22, 0, 0x90, 0],
+                    [0x00, 0], [0x02, 0]):
+        assert classify([0x68, 0x68, 0x68] + list(unknown) + SHORT) is None
+
+
+def test_no_pulls_or_non_indirect_termination_still_refuse():
+    assert classify(SHORT) is None
+    assert classify([0x68, 0x0A, 0xAA, 0x60]) is None
+
+
+def test_a_conditional_path_can_skip_the_only_pull():
+    for branch in (0x90, 0xB0, 0xF0, 0xD0, 0x30, 0x10, 0x50, 0x70):
+        # The taken path consumes no caller byte, even though linear decode does.
+        assert classify([branch, 1, 0x68] + SHORT) is None
