+static bool bridge_bus_read_word(void*c,uint32_t l,uint32_t h,uint16_t*out){assert(c==&g_cpu&&!s_interp_bus_timing_active);word_reads++;if(!claimed)return false;addresses[calls++]=l;addresses[calls++]=h;*out=0xbbaa;return true;}
