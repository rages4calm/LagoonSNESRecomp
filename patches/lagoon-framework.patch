+"""Execute actual generated JSL code across normal, nonlocal and suspended returns."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'recompiler'))
+
+
+def exercise_jsl_suspension(tmp_path):
+    from v2.emitter_helpers import pb_save_restore_envelope
+    compiler = os.environ.get('CC') or shutil.which('cc')
+    if not compiler:
+        raise unittest.SkipTest('C compiler required')
+    envelope='\n'.join(pb_save_restore_envelope(0x0c,
+        ['RecompReturn _r = callee(cpu, mode);'], trace_pc24=0x01d49e))
+    source='''#include <stdint.h>
+#include <assert.h>
+typedef uint8_t uint8;
+typedef int RecompReturn;
+enum {RECOMP_RETURN_NORMAL=0};
+typedef struct {uint8 PB;} CpuState;
+static int suspended;
+static int interp_bridge_lle_unwind_pending(void) {return suspended;}
+#define cpu_trace_pb_change(...) ((void)0)
+#define cpu_trace_event(...) ((void)0)
+#define cpu_trace_mark_nlr_exit(...) ((void)0)
+static RecompReturn callee(CpuState *cpu,int mode) {
+ assert(cpu->PB==0x0c);
+ if(mode==2){suspended=1;cpu->PB=0;return 0x40000000;}
+ return mode==1?2:0;
+}
+static RecompReturn emitted(CpuState *cpu,int mode) {
+'''+envelope+'''
+ return RECOMP_RETURN_NORMAL;
+}
+int main(void) {
+ CpuState cpu={1};
+ assert(emitted(&cpu,0)==0 && cpu.PB==1);
+ assert(emitted(&cpu,1)==1 && cpu.PB==1);
+ assert(emitted(&cpu,2)==0x3fffffff && cpu.PB==0);
+ return 0;
+}
+'''
+    c=tmp_path/'jsl_suspend.c';c.write_text(source,encoding='utf-8')
+    exe=tmp_path/('jsl_suspend.exe' if os.name=='nt' else 'jsl_suspend')
+    subprocess.run([compiler,'-std=c11','-Wall','-Wextra','-Werror',str(c),'-o',str(exe)],check=True,capture_output=True)
+    subprocess.run([str(exe)],check=True,capture_output=True)
+
+
+class JslYieldBankChecks(unittest.TestCase):
+    def test_generated_jsl_return_and_suspension_banks(self):
+        with tempfile.TemporaryDirectory() as directory:
+            exercise_jsl_suspension(Path(directory))
+
+
+if __name__=='__main__':unittest.main()
