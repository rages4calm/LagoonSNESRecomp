+"""Compile the actual production continuation matcher with synthetic frames."""
+from pathlib import Path
+import os, shutil, subprocess, tempfile
+import unittest
+ROOT=Path(__file__).resolve().parents[2]
+def _check_actual_continuation_matcher():
+    compiler=os.environ.get('CC') or shutil.which('clang') or shutil.which('gcc')
+    if not compiler:
+        raise unittest.SkipTest('C compiler required')
+    header=(ROOT/'runner/src/snes/interp_bridge.h').read_text()
+    source=(ROOT/'runner/src/snes/interp_bridge.c').read_text()
+    types=header.split('/* BEGIN AOT_CONTINUATION_TYPES */',1)[1].split('/* END AOT_CONTINUATION_TYPES */',1)[0]
+    policy=source.split('/* BEGIN AOT_CONTINUATION_POLICY -- pure, bounded provenance matcher. */',1)[1].split('/* END AOT_CONTINUATION_POLICY */',1)[0]
+    with tempfile.TemporaryDirectory(prefix='aot-continuation-') as tmp:
+        path=Path(tmp)
+        (path/'continuation_policy_under_test.h').write_text(types+policy)
+        exe=path/('test.exe' if os.name=='nt' else 'test')
+        subprocess.run([compiler,'-std=c11','-Wall','-Wextra','-Werror','-Wno-unused-function','-I',str(ROOT/'runner/src'),'-I',str(path),str(ROOT/'tests/aot_continuation_policy_test.c'),'-o',str(exe)],check=True)
+        subprocess.run([str(exe)],check=True)
+
+class ContinuationPolicyTests(unittest.TestCase):
+    def test_actual_production_matcher(self):
+        _check_actual_continuation_matcher()
+
+if __name__=="__main__":
+    unittest.main()
