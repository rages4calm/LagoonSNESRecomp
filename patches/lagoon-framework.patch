diff --git a/tests/runtime_dispatch/dma_start_observer_test.c b/tests/runtime_dispatch/dma_start_observer_test.c
new file mode 100644
index 0000000..3ebf8e4
--- /dev/null
+++ b/tests/runtime_dispatch/dma_start_observer_test.c
@@ -0,0 +1,47 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "snes/dma.h"
+#include "snes/ppu.h"
+#include "snes/sdd1.h"
+Ppu *g_ppu;
+uint8_t g_ppu_wlog_src;
+uint8_t snes_readBBus(Snes *s, uint8_t a) { (void)s; (void)a; return 0; }
+void snes_writeBBus(Snes *s, uint8_t a, uint8_t v) { (void)s; (void)a; (void)v; }
+uint8_t snes_read(Snes *s, uint32_t a) { (void)s; (void)a; return 0; }
+void snes_write(Snes *s, uint32_t a, uint8_t v) { (void)s; (void)a; (void)v; }
+uint8_t sdd1_dma_get_byte(Sdd1 *s, int ch) { (void)s; (void)ch; return 0; }
+void sdd1_dma_init(Sdd1 *s, int ch, uint32_t source, uint32_t size) {
+  (void)s; (void)ch; (void)source; (void)size;
+}
+bool sdd1_dma_active(Sdd1 *s, int ch) { (void)s; (void)ch; return false; }
+static unsigned calls, channels;
+static void observe(const Dma *dma, unsigned channel, const DmaChannel *t) {
+  assert(t == &dma->channel[channel]);
+  assert(t->aAdr == 0x2000 + channel && t->size == 0x220);
+  assert(t->dmaActive); /* enabled but source/size not consumed */
+  ++calls; channels |= 1u << channel;
+}
+int main(void) {
+  Dma off = {0}, observed = {0};
+  for (unsigned i=0;i<8;++i) {
+    off.channel[i].aAdr = (uint16_t)(0x2000+i);
+    off.channel[i].aBank = 0x7e;
+    off.channel[i].bAdr = 4;
+    off.channel[i].size = 0x220;
+  }
+  observed = off;
+  dma_startDma(&off, 0x85, false);
+  dma_set_start_observer(observe);
+  dma_startDma(&observed, 0x85, false);
+  assert(calls==3 && channels==0x85);
+  assert(!memcmp(&off,&observed,sizeof(off)));
+  dma_startDma(&observed, 0x85, true);
+  dma_startDma(&observed, 0, false);
+  assert(calls==3); /* HDMA/disabled masks do not observe ordinary starts */
+  dma_set_start_observer(NULL);
+  dma_startDma(&observed, 1, false);
+  assert(calls==3);
+  puts("DMA start observer: selected channels, pre-transfer source, unchanged state, HDMA, unregister PASS");
+  return 0;
+}
