@@ -0,0 +1,27 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "snes/aot_deny_key.h"
+int main(void) {
+    uint32_t key = 0;
+    assert(aot_deny_parse_key("0084E9", &key) == 1 && key == 0x84e9u);
+    assert(aot_deny_parse_key("  0x0084E9 # legacy all-mode\n", &key) == 1 && key == 0x84e9u);
+    assert(aot_deny_parse_key("0084E9:M1X1\n", &key) == 1);
+    assert(key == aot_deny_variant_key(0x84e9, 1, 1));
+    assert(key != aot_deny_variant_key(0x84e9, 1, 0));
+    assert(aot_deny_parse_key("00871c:m0x1 # exact mode", &key) == 1);
+    assert(key == aot_deny_variant_key(0x871c, 0, 1));
+    for (unsigned m = 0; m < 2; m++) for (unsigned x = 0; x < 2; x++) {
+        char text[40]; snprintf(text, sizeof text, "FFFFFF:M%uX%u", m, x);
+        assert(aot_deny_parse_key(text, &key) == 1);
+        assert(key == aot_deny_variant_key(0xffffff, m, x));
+        assert(key > 0xffffffu);
+    }
+    const char *invalid[] = {"1000000", "-1", "+1", "0084E9:M2X0", "0084E9:M0X2",
+        "0084E9:M", "0084E9:M0", "0084E9:M0X", "0084E9:", "0084E9:M0X0extra", "0084E9junk"};
+    for (unsigned i = 0; i < sizeof invalid / sizeof *invalid; i++)
+        assert(aot_deny_parse_key(invalid[i], &key) == -1);
+    assert(aot_deny_parse_key(" # comment", &key) == 0);
+    assert(aot_deny_parse_key("\r\n", &key) == 0);
+    puts("AOT deny exact-mode parser: PASS");
+}
