diff --git a/runner/windows/snesrecomp_utf8.manifest b/runner/windows/snesrecomp_utf8.manifest
new file mode 100644
index 0000000000000000000000000000000000000000..9db0bc1a6414b3851c7d5139b779ca7a59f66823
--- /dev/null
+++ b/runner/windows/snesrecomp_utf8.manifest
@@ -0,0 +1,40 @@
+<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<!--
+  Application manifest for every SNES host executable on Windows.
+
+  activeCodePage=UTF-8 makes the process ANSI code page UTF-8 (Windows 10 1903
+  and later). Paths cross the host as narrow strings: GetModuleFileNameA,
+  fopen and the command line on the C side; std::filesystem, SDL and the
+  launcher's pickers on the other. Without this the two sides disagree (ANSI
+  vs UTF-8), and an install folder such as "Mega Man X Recompilé" aborts at
+  startup. Older Windows ignores the element; the host logs a breadcrumb then.
+
+  The rest restates MinGW's default manifest (asInvoker, supported OS list),
+  which an explicit manifest replaces.
+-->
+<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
+  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
+    <security>
+      <requestedPrivileges>
+        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
+      </requestedPrivileges>
+    </security>
+  </trustInfo>
+  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
+    <application>
+      <!-- Windows 10 and 11 -->
+      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
+      <!-- Windows 8.1 -->
+      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
+      <!-- Windows 8 -->
+      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
+      <!-- Windows 7 -->
+      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
+    </application>
+  </compatibility>
+  <application xmlns="urn:schemas-microsoft-com:asm.v3">
+    <windowsSettings>
+      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
+    </windowsSettings>
+  </application>
+</assembly>
