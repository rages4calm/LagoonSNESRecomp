+"""Guarded HLE retains native fallback and exact invocation context."""
+import ast, json, os, pathlib, shutil, subprocess, sys, tempfile, unittest
+ROOT=pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/'recompiler'))
+from v2.cfg_loader import load_bank_cfg
+from v2.emit_function import emit_function
+
+class GuardTests(unittest.TestCase):
+ def test_cfg_refusals(self):
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td)/'bank00.cfg'
+   p.write_text('bank = 00\nforce_lle_variant 0084E9:M1X1\nhle_guard_func 8000 TryGuard\n')
+   cfg=load_bank_cfg(str(p));self.assertEqual(cfg.hle_guard_func,{0x8000:'TryGuard'});self.assertFalse(cfg.entries);self.assertFalse(cfg.hle_func)
+   for directive in ['hle_guard_func 8000','hle_guard_func 8000 bad-name','hle_guard_func 10000 TryGuard','hle_guard_func 8000 TryGuard extra','hle_guard_func 8000 TryGuard\nhle_guard_func 8000 Again','hle_guard_func 8000 TryGuard\nhle_func 8000 Replaced']:
+    p.write_text('bank = 00\n'+directive+'\n')
+    with self.assertRaises(ValueError):load_bank_cfg(str(p))
+
+ def test_actual_emitted_false_true_context_and_deadline(self):
+  rom=bytearray([255]*32768);rom[:2]=bytes([0xea,0x60])
+  old=emit_function(bytes(rom),0,0x8000,1,0,func_name='Guarded')
