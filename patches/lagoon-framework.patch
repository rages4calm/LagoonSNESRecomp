+        CHECK(s18_same(&s, &d) && s.site == INTERP_RESUME_SITE_STEP_CAP &&
+              s.master < 1000 + g_s18_span && d.interpreted * 10 < s.interpreted,
+              "step cap: site=%d/%d interpreted=%u/%u", s.site, d.site,
+              s.interpreted, d.interpreted); }
+      g_s18_span = 50000;
+
+      /* Negative cases: each must run exactly as if nothing were declared,
+       * interpreted step for step. */
+      printf("[S18] negative: an IRQ that could fire mid-wait prevents replay\n");
+      g_test_snes.vIrqEnabled = true;
+      { const S18Run s = s18_run(wait, sizeof wait, 0, 0);
+        const S18Run d = s18_run(wait, sizeof wait, 0x008904, 0);
+        CHECK(s18_same(&s, &d) && d.interpreted == s.interpreted,
+              "V-IRQ armed, I clear: interpreted=%u/%u exp equal",
+              s.interpreted, d.interpreted); }
+      g_test_snes.vIrqEnabled = false;
+      g_test_snes.hIrqEnabled = true;
+      { const S18Run s = s18_run(wait, sizeof wait, 0, 0);
+        const S18Run d = s18_run(wait, sizeof wait, 0x008904, 0);
+        CHECK(s18_same(&s, &d) && d.interpreted == s.interpreted,
+              "H-IRQ armed, I clear: interpreted=%u/%u exp equal",
+              s.interpreted, d.interpreted);
+        /* With I set the armed timer cannot interrupt: replay is allowed. */
+        const S18Run si = s18_run(wait, sizeof wait, 0, 1);
+        const S18Run di = s18_run(wait, sizeof wait, 0x008904, 1);
+        CHECK(s18_same(&si, &di) && di.interpreted * 10 < si.interpreted,
+              "H-IRQ armed, I set: exp the same result, replayed"); }
+      g_test_snes.hIrqEnabled = false;
+
+      /* I may differ inside a cycle even when its endpoint state repeats.
+       * The armed timer asserts after replay would have begun. */
+      printf("[S18] IRQ mask changes inside the idle cycle\n");
+      { static const uint8_t mask_cycle[] = {
+            0xA9,0xFF, 0x85,0x01,          /* LDA #$FF / STA $01 */
+            0x78, 0xA5,0x01, 0x58, 0xEA,  /* SEI / poll / CLI / NOP */
+            0xD0,0xF9};                   /* BNE $8904 */
+        g_test_snes.hIrqEnabled = true;
+        g_test_irq_master = 10000;
+        g_test_snes.inIrq = false;
+        const S18Run s = s18_run(mask_cycle, sizeof mask_cycle, 0, 1);
+        g_test_snes.inIrq = false;
+        const S18Run d = s18_run(mask_cycle, sizeof mask_cycle, 0x008905, 1);
+        if (!s18_same(&s, &d)) { s18_print("spin", &s); s18_print("declared", &d); }
+        CHECK(s18_same(&s, &d) && s.site == INTERP_RESUME_SITE_IRQ_PENDING &&
+              s.interpreted == d.interpreted && s.master < 51000,
+              "changing I skipped IRQ: site=%d/%d master=%llu/%llu", s.site,
+              d.site, (unsigned long long)s.master, (unsigned long long)d.master);
+        g_test_irq_master = 0;
+        g_test_snes.inIrq = false;
+        g_test_snes.hIrqEnabled = false; }
+
+      printf("[S18] negative: a pending IRQ ends the run before any replay\n");
+      g_test_snes.inIrq = true;
+      { const S18Run s = s18_run(wait, sizeof wait, 0, 0);
+        const S18Run d = s18_run(wait, sizeof wait, 0x008904, 0);
+        CHECK(s18_same(&s, &d) && s.site == INTERP_RESUME_SITE_IRQ_PENDING &&
+              s.interpreted == 1 && d.interpreted == 1,
+              "pending IRQ: site=%d/%d interpreted=%u/%u", s.site, d.site,
+              s.interpreted, d.interpreted); }
+      g_test_snes.inIrq = false;
+
+      printf("[S18] negative: a declared poll that reads a device is not exempt\n");
+      { static const uint8_t port[] = {0xAD,0x40,0x21,         /* LDA $2140 */
+                                       0xD0,0xFB};             /* BNE -5    */
+        const S18Run s = s18_run(port, sizeof port, 0, 1);
+        const S18Run d = s18_run(port, sizeof port, 0x008900, 1);
+        if (!s18_same(&s, &d)) { s18_print("spin", &s); s18_print("declared", &d); }
+        CHECK(s18_same(&s, &d) && d.interpreted == s.interpreted &&
+              s.interpreted > 1000,
+              "APU-port poll: interpreted=%u/%u exp equal", s.interpreted,
+              d.interpreted); }
+
+      printf("[S18] negative: a device read elsewhere in the cycle prevents replay\n");
+      { static const uint8_t mixed[] = {0xA9,0xFF, 0x85,0x01,   /* LDA #$FF / STA $01 */
+                                        0xA5,0x01,              /* LDA $01            */
+                                        0x0D,0x11,0x42,         /* ORA $4211 (TIMEUP) */
+                                        0xD0,0xF9};             /* BNE -7             */
+        const S18Run s = s18_run(mixed, sizeof mixed, 0, 1);
+        const S18Run d = s18_run(mixed, sizeof mixed, 0x008904, 1);
+        CHECK(s18_same(&s, &d) && d.interpreted == s.interpreted,
+              "$4211 in the cycle: interpreted=%u/%u exp equal",
+              s.interpreted, d.interpreted); }
+
+      printf("[S18] negative: HDMA into the WRAM port prevents replay\n");
+      { static Dma s_dma;
+        memset(&s_dma, 0, sizeof s_dma);
+        s_dma.channel[3].hdmaActive = true;
+        s_dma.channel[3].bAdr = 0x80;           /* $2180 WMDATA */
+        g_test_snes.dma = &s_dma;
+        const S18Run s = s18_run(wait, sizeof wait, 0, 1);
+        const S18Run d = s18_run(wait, sizeof wait, 0x008904, 1);
+        CHECK(s18_same(&s, &d) && d.interpreted == s.interpreted,
+              "HDMA to $2180: interpreted=%u/%u exp equal", s.interpreted,
+              d.interpreted);
+        s_dma.channel[3].bAdr = 0x18;           /* $2118 VMDATAL: harmless */
+        const S18Run v = s18_run(wait, sizeof wait, 0x008904, 1);
+        CHECK(s18_same(&s, &v) && v.interpreted * 10 < s.interpreted,
+              "HDMA to VRAM: exp replayed");
+        g_test_snes.dma = NULL; }
+      interp_bridge_clear_idle_polls();
+    }
+    /* S19: the quiescent detector's candidates. A loop whose state at a PC
+     * alternates (EOR #$01 / BRA) recurs only every second visit, so the most
+     * recent visit to that PC never matches; the detector must still find the
+     * older entry. Each case pins the step at which it fires on the full
+     * 64-entry scan, so any faster lookup has to reproduce it exactly. */
+    printf("[S19] quiescent detector: candidates beyond the last same-PC visit\n");
+    { static const uint8_t alt[] = {0x49,0x01, 0x80,0xFC};      /* EOR #$01 / BRA -4 */
+      uint8_t alt_long[2 + 29 + 2];                             /* EOR, 29 NOPs, BRA */
+      alt_long[0] = 0x49; alt_long[1] = 0x01;
+      memset(alt_long + 2, 0xEA, 29);
+      alt_long[31] = 0x80; alt_long[32] = (uint8_t)(0x100 - 33);
+      static const uint8_t cyc4[] = {0x1A, 0x29,0x03, 0x80,0xFB};  /* INC A / AND #3 / BRA */
+      static const uint8_t wait[] = {0xAF,0x00,0x20,0x7E, 0xF0,0xFA}; /* LDA $7E2000 / BEQ */
+      static const uint8_t count[] = {0xE8, 0x80,0xFD};         /* INX / BRA (16-bit X) */
+      struct { const char *what; const uint8_t *code; int len, x16, quiescent;
+               unsigned expect; } cases[] = {
+        {"EOR #$01 / BRA alternates A", alt, (int)sizeof alt, 0, 1, 68u},
+        {"alternating over 31 PCs", alt_long, (int)sizeof alt_long, 0, 1, 125u},
+        {"A cycles through four values", cyc4, (int)sizeof cyc4, 0, 1, 73u},
+        {"stable WRAM wait", wait, (int)sizeof wait, 0, 1, 66u},
+        {"counting loop is never stable", count, (int)sizeof count, 1, 0, 22223u},
+      };
+      for (unsigned k = 0; k < sizeof cases / sizeof cases[0]; k++) {
+        const S19Run r = s19_run(cases[k].code, cases[k].len, cases[k].x16);
+        printf("    %s: rc=%d site=%d steps=%u resume=$%06X\n", cases[k].what,
+               r.rc, r.site, r.steps, (unsigned)r.resume);
+        CHECK(r.site == (cases[k].quiescent ? INTERP_RESUME_SITE_QUIESCENT
+                                            : INTERP_RESUME_SITE_DEADLINE),
+              "%s: site=%d", cases[k].what, r.site);
+        CHECK(r.steps == cases[k].expect, "%s: fired after %u steps, exp %u",
+              cases[k].what, r.steps, cases[k].expect);
+      }
+    }
     printf("\n==== interp_bridge Phase-1: %d/%d checks passed ====\n", g_check - g_fail, g_check);
     if (g_fail) { printf("RESULT: FAIL (%d)\n", g_fail); return 1; }
     tier2_capture_close();
diff --git a/tests/joypad/keybinds_appimage_test.c b/tests/joypad/keybinds_appimage_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..e835a4e445fd71302e89a3633339f35cf74aefbb
--- /dev/null
+++ b/tests/joypad/keybinds_appimage_test.c
@@ -0,0 +1,60 @@
+/* Exercise the same reload used at desktop game startup and launcher return. */
+#define _POSIX_C_SOURCE 200809L
+#ifndef SDL_MAIN_HANDLED
+#define SDL_MAIN_HANDLED
+#endif
+#include "keybinds.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(__linux__)
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+int main(void) {
+#if defined(__linux__)
+    char root[] = "/tmp/snes-keybinds-XXXXXX", cwd[4096];
+    char user[4096], mount[4096], exe[4096], app[4096], ini[4096], payload_ini[4096];
+    const char *old_app = getenv("APPIMAGE");
+    char *saved_app = old_app ? strdup(old_app) : NULL;
+    assert(getcwd(cwd, sizeof(cwd)) && mkdtemp(root));
+    snprintf(user, sizeof(user), "%s/user", root);
+    snprintf(mount, sizeof(mount), "%s/mount", root);
+    snprintf(exe, sizeof(exe), "%s/mount/Game", root);
+    snprintf(app, sizeof(app), "%s/user/Game.AppImage", root);
+    snprintf(ini, sizeof(ini), "%s/user/keybinds.ini", root);
+    snprintf(payload_ini, sizeof(payload_ini), "%s/mount/keybinds.ini", root);
+    assert(!mkdir(user, 0700) && !mkdir(mount, 0700));
+    FILE *f = fopen(ini, "w"); assert(f);
+    fputs("[player1]\nb = F9\ny = F10\n", f); assert(!fclose(f));
+    assert(!setenv("APPIMAGE", app, 1) && !chdir(root));
+    keybinds_init(exe);
+    assert(keybinds_get()->p1.b == SDL_SCANCODE_F9);
+    assert(keybinds_get()->p1.y == SDL_SCANCODE_F10);
+    uint8_t keys[512] = {0}; keys[SDL_SCANCODE_F9] = 1;
+    assert(keybinds_read_player_runner(keys, 1) == 1);
+    keybinds_set_button(1, 1, SDL_SCANCODE_F11);
+    keybinds_save();
+    keybinds_init(exe);
+    assert(keybinds_get()->p1.b == SDL_SCANCODE_F11);
+    assert(keybinds_get()->p1.y == SDL_SCANCODE_F10);
+    assert(access(payload_ini, F_OK) != 0);
+
+    /* Ordinary Linux executables still honor the supplied executable path. */
+    assert(!unsetenv("APPIMAGE"));
+    f = fopen(payload_ini, "w"); assert(f);
+    fputs("[player1]\nb = F12\n", f); assert(!fclose(f));
+    keybinds_init(exe);
+    assert(keybinds_get()->p1.b == SDL_SCANCODE_F12);
+    if (saved_app) { assert(!setenv("APPIMAGE", saved_app, 1)); free(saved_app); }
+    assert(!chdir(cwd));
+    assert(!unlink(ini) && !unlink(payload_ini));
+    assert(!rmdir(user) && !rmdir(mount) && !rmdir(root));
+    puts("AppImage keyboard startup, reload and persistence passed");
+#else
+    puts("AppImage keyboard paths apply only on Linux");
+#endif
+    return 0;
+}
diff --git a/tests/launcher/rom_identity_test.c b/tests/launcher/rom_identity_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..aaaeb90f7ed07b3d4b15514c6291ae5513ed973d
--- /dev/null
+++ b/tests/launcher/rom_identity_test.c
@@ -0,0 +1,211 @@
+/* A refused ROM is named, not just reported as a digest mismatch. Builds
+ * synthetic LoROM images with valid internal headers, so it stays ROM-free. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "rom_identity.h"
+#include "sha256.h"
+
+static void fail(const char *message, const char *detail) {
+    fprintf(stderr, "rom_identity_test: FAIL: %s\n  %s\n", message,
+            detail ? detail : "");
+    exit(1);
+}
+
+static void require_has(const char *text, const char *part, const char *label) {
+    if (!strstr(text, part)) {
+        char detail[2048];
+        snprintf(detail, sizeof(detail), "missing \"%s\" in \"%s\"", part, text);
+        fail(label, detail);
+    }
+}
+
+static void to_hex(const uint8_t *d, size_t n, char *out) {
+    for (size_t i = 0; i < n; ++i) snprintf(out + i * 2, 3, "%02x", d[i]);
+}
+
+/* 64 KiB LoROM image with an internal header naming `title`, `version` and
+ * `region`, and a correct checksum/complement pair. */
+static void make_rom(uint8_t *rom, size_t len, const char *title,
+                     uint8_t version, uint8_t region, uint8_t fill) {
+    memset(rom, fill, len);
+    uint8_t *h = rom + 0x7FC0;
+    memset(h, ' ', 21);
+    memcpy(h, title, strlen(title));
+    h[0x15] = 0x20;  /* LoROM */
+    h[0x19] = region;
+    h[0x1B] = version;
+    h[0x3C] = 0x00; h[0x3D] = 0x80;  /* reset vector $8000 */
+    h[0x1C] = 0xFF; h[0x1D] = 0xFF; h[0x1E] = 0x00; h[0x1F] = 0x00;
+    uint32_t sum = 0;
+    for (size_t i = 0; i < len; ++i) sum += rom[i];
+    const unsigned checksum = sum & 0xFFFF;
+    h[0x1E] = (uint8_t)checksum; h[0x1F] = (uint8_t)(checksum >> 8);
+    h[0x1C] = (uint8_t)~checksum; h[0x1D] = (uint8_t)(~checksum >> 8);
+}
+
+static void write_file(const char *path, const void *data, size_t n) {
+    FILE *f = fopen(path, "wb");
+    if (!f || fwrite(data, 1, n, f) != n) fail("could not write fixture", path);
+    fclose(f);
+}
+
+enum { kLen = 0x10000 };
+
+int main(void) {
+    static uint8_t good[kLen], old[kLen], other[kLen], hacked[kLen];
+    static uint8_t headered[kLen + 512];
+    make_rom(good, kLen, "TEST QUEST", 1, 1, 0x11);
+    make_rom(old, kLen, "TEST QUEST", 0, 1, 0x22);
+    make_rom(other, kLen, "TEST QUEST 3", 0, 1, 0x33);
+    make_rom(hacked, kLen, "TEST QUEST", 0, 1, 0x44);
+    hacked[0x100] ^= 0x5A;  /* patched after the checksum was written */
+    memset(headered, 0, 512);
+    memcpy(headered + 512, good, kLen);
+
+    uint8_t d[32];
+    char good_sha[65], old_sha[65], other_sha[65], hacked_sha[65];
+    sha256_compute(good, kLen, d);   to_hex(d, 32, good_sha);
+    sha256_compute(old, kLen, d);    to_hex(d, 32, old_sha);
+    sha256_compute(other, kLen, d);  to_hex(d, 32, other_sha);
+    sha256_compute(hacked, kLen, d); to_hex(d, 32, hacked_sha);
+
+    const SnesRomRevision catalog[] = {
+        {"Test Quest (USA) (Rev 1)", good_sha, NULL, NULL, NULL},
+        {"Test Quest (USA)", old_sha, NULL, NULL, "Rev 0 softlocks in stage 2."},
+        {"Test Quest 3 (USA)", other_sha, NULL, NULL, NULL},
+    };
+    char why[1536];
+    SnesRomFacts facts;
+
+    /* The required dump, with or without a copier header. */
+    if (snes_rom_identity_check_image(good, kLen, catalog, 3, good_sha, "Test Quest",
+                                      NULL, &facts, why, sizeof(why)) != kSnesRom_Ok)
+        fail("required dump refused", why);
+    if (facts.revision != 0) fail("required dump not identified", NULL);
+    if (snes_rom_identity_check_image(headered, sizeof(headered), catalog, 3,
+                                      good_sha, "Test Quest", NULL, &facts, why,
+                                      sizeof(why)) != kSnesRom_Ok)
+        fail("headered dump refused", why);
+    if (strcmp(facts.sha256_hex, good_sha) != 0) fail("copier header hashed", NULL);
+
+    /* Other revision: named, requirement with SHA-256, note, help. */
+    if (snes_rom_identity_check_image(old, kLen, catalog, 3, good_sha, "Test Quest",
+                                      "Headers are fine.", &facts, why,
+                                      sizeof(why)) != kSnesRom_Wrong)
+        fail("old revision not reported as wrong", why);
+    require_has(why, "This is Test Quest (USA).", "names the revision");
+    require_has(why, "Test Quest needs Test Quest (USA) (Rev 1) (SHA-256 ", "requirement");
+    require_has(why, good_sha, "required digest");
+    require_has(why, "Rev 0 softlocks in stage 2.", "note");
+    require_has(why, "Headers are fine.", "help");
+
+    /* Compact form for a status line. */
+    snes_rom_identity_check_image(other, kLen, catalog, 3, good_sha, NULL, "unused",
+                                  &facts, why, 256);
+    require_has(why, "Wrong ROM: this is Test Quest 3 (USA). Select Test Quest (USA) (Rev 1)",
+                "compact wrong form");
+    if (strstr(why, "unused")) fail("compact form carries help", why);
+
+    /* Unknown dump: internal header and checksum verdict, its own digest. */
+    if (snes_rom_identity_check_image(hacked, kLen, catalog, 3, good_sha,
+                                      "Test Quest", NULL, &facts, why,
+                                      sizeof(why)) != kSnesRom_Unknown)
+        fail("hacked dump not unknown", why);
+    require_has(why, "Its header reads \"TEST QUEST\" v1.0 (North America), but its "
+                     "checksum no longer matches", "header description");
+    require_has(why, hacked_sha, "file digest");
+    require_has(why, good_sha, "required digest");
+    snes_rom_identity_check_image(hacked, kLen, catalog, 3, good_sha, NULL, NULL,
+                                  &facts, why, 256);
+    require_has(why, "Not a known dump (header \"TEST QUEST\" v1.0, North America, "
+                     "checksum mismatch). Select Test Quest (USA) (Rev 1)",
+                "compact unknown form");
+    if (strlen(why) >= 255) fail("compact form truncated", why);
+
+    /* An untouched but uncatalogued dump keeps a valid checksum. */
+    {
+        static uint8_t clean[kLen];
+        make_rom(clean, kLen, "TEST QUEST", 2, 0, 0x55);
+        snes_rom_identity_check_image(clean, kLen, catalog, 3, good_sha, "Test Quest",
+                                      NULL, &facts, why, sizeof(why));
+        require_has(why, "\"TEST QUEST\" v1.2 (Japan).", "clean header");
+        if (strstr(why, "checksum")) fail("clean dump blamed on checksum", why);
+    }
+
+    /* Without a catalog the requirement still gives the digest. */
+    snes_rom_identity_check_image(old, kLen, NULL, 0, good_sha, "Test Quest", NULL,
+                                  &facts, why, sizeof(why));
+    require_has(why, "Test Quest needs the original ROM (SHA-256 ", "no-catalog requirement");
+
+    /* Archives and unreadable files. */
+    {
+        const uint8_t zip[] = {'P', 'K', 3, 4, 20, 0, 0, 0};
+        if (snes_rom_identity_check_image(zip, sizeof(zip), catalog, 3, good_sha,
+                                          "Test Quest", NULL, &facts, why,
+                                          sizeof(why)) != kSnesRom_Archive)
+            fail("zip not an archive", why);
+        require_has(why, "ZIP archive", "archive kind");
+        const uint8_t sevenz[] = {'7', 'z', 0xBC, 0xAF, 0x27, 0x1C, 0, 4};
+        snes_rom_identity_check_image(sevenz, sizeof(sevenz), catalog, 3, good_sha,
+                                      "Test Quest", NULL, &facts, why, sizeof(why));
+        require_has(why, "7-Zip archive", "7z kind");
+    }
+    if (snes_rom_identity_check_file("rom_identity_missing.sfc", catalog, 3, good_sha,
+                                     "Test Quest", NULL, &facts, why,
+                                     sizeof(why)) != kSnesRom_Unreadable)
+        fail("missing file not unreadable", why);
+
+    /* File path agrees with the image path. */
+    write_file("rom_identity_old.smc", headered, sizeof(headered));
+    if (snes_rom_identity_check_file("rom_identity_old.smc", catalog, 3, good_sha,
+                                     "Test Quest", NULL, &facts, why,
+                                     sizeof(why)) != kSnesRom_Ok)
+        fail("file check refused the headered required dump", why);
+    remove("rom_identity_old.smc");
+
+    /* The right dump is accepted even if it begins with archive magic. */
+    {
+        static uint8_t zipish[kLen];
+        char zipish_sha[65];
+        make_rom(zipish, kLen, "TEST QUEST", 1, 1, 0x66);
+        zipish[0] = 'P'; zipish[1] = 'K'; zipish[2] = 3; zipish[3] = 4;
+        sha256_compute(zipish, kLen, d); to_hex(d, 32, zipish_sha);
+        if (snes_rom_identity_check_image(zipish, kLen, NULL, 0, zipish_sha,
+                                          "Test Quest", NULL, &facts, why,
+                                          sizeof(why)) != kSnesRom_Ok)
+            fail("archive magic overrode a matching digest", why);
+    }
+    /* Without a requirement a file is accepted unread, even a missing one. */
+    if (snes_rom_identity_check_file("rom_identity_missing.sfc", catalog, 3, NULL,
+                                     "Test Quest", NULL, &facts, why,
+                                     sizeof(why)) != kSnesRom_Ok)
+        fail("no requirement read the file", why);
+
+    /* No requirement: anything readable is accepted. */
+    if (snes_rom_identity_check_image(old, kLen, catalog, 3, NULL, "Test Quest",
+                                      NULL, &facts, why, sizeof(why)) != kSnesRom_Ok)
+        fail("no requirement refused a ROM", why);
+    if (facts.revision != 1) fail("no requirement: revision not identified", NULL);
+
+    /* Matching rules: case-insensitive, and every given digest must agree. */
+    {
+        char upper[65];
+        for (int i = 0; i < 65; ++i)
+            upper[i] = (good_sha[i] >= 'a' && good_sha[i] <= 'f')
+                           ? (char)(good_sha[i] - 32) : good_sha[i];
+        SnesRomRevision r = {"x", upper, NULL, NULL, NULL};
+        if (!snes_rom_revision_matches(&r, good_sha, "", "")) fail("case-insensitive", NULL);
+        r.crc32_hex = "00000000";
+        if (snes_rom_revision_matches(&r, good_sha, "", "12345678"))
+            fail("disagreeing CRC still matched", NULL);
+        SnesRomRevision none = {"x", NULL, NULL, NULL, NULL};
+        if (snes_rom_revision_matches(&none, good_sha, "", ""))
+            fail("digest-less entry matched", NULL);
+    }
+
+    puts("rom_identity_test: PASS");
+    return 0;
+}
