+"""A timing-unsafe new mode must not remove established native sibling modes."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / 'recompiler'))
+from v2.cfg_loader import load_bank_cfg
+
+
+class ForceLleVariantTests(unittest.TestCase):
+    def test_python_parser_keeps_modes_separate(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / 'bank00.cfg'
+            path.write_text('bank = 00\nforce_lle_variant 0084E9:M1X1\nforce_lle_variant 0084e9:m0x0\n')
+            cfg = load_bank_cfg(str(path))
+            self.assertEqual(cfg.force_lle_variants, {(0x84e9, 1, 1), (0x84e9, 0, 0)})
+            self.assertFalse(cfg.force_lle)
+
+    def test_python_parser_fails_closed(self):
+        values = ('0084E9', '0084E9:M2X0', '0084E9:M1X1junk', '1000000:M1X0',
+                  '0084E9:M1X0 extra', '0x0084E9:M1X0',
+                  '0084E9:M1X0\nforce_lle_variant 0084e9:m1x0')
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / 'bank00.cfg'
+            for value in values:
+                with self.subTest(value=value):
+                    path.write_text('bank = 00\nforce_lle_variant ' + value + '\n')
+                    with self.assertRaises(ValueError):
+                        load_bank_cfg(str(path))
+
+    def test_native_manifest_and_dispatch_defer_only_exact_mode_and_mirror(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            rom = bytearray([0xff] * 0x8000)
+            rom[0:9] = bytes.fromhex('201080e23020108060')  # JSR M1X0; SEP X; JSR M1X1; RTS
+            rom[0x10] = 0x60
+            rom[0x20] = 0x60
+            (root / 'test.sfc').write_bytes(rom)
+            cfg = root / 'cfg'; cfg.mkdir()
+            (cfg / 'bank00.cfg').write_text(
+                'bank = 00\nfunc Main 8000 end:8009 entry_mx:1,0\n'
+                'func Shared 8010 end:8011 entry_mx:1,0\n'
+                'func DeferredRoot 8020 end:8021 entry_mx:1,1\n'
+                'force_lle_variant 808010:M1X1\n'
+                'force_lle_variant 008020:M1X1\n')
+            out = root / 'gen'
+            command = [sys.executable, '-P', str(REPO / 'tools/v2_emit.py'),
+                '--rom', str(root / 'test.sfc'), '--cfg-dir', str(cfg), '--out-dir', str(out),
+                '--cfg-roots', '--no-host-root-scan']
+            completed = subprocess.run(command, capture_output=True, text=True)
+            self.assertEqual(completed.returncode, 0, completed.stdout + completed.stderr)
+            manifest = json.loads((out / 'program_manifest.json').read_text())
+            self.assertEqual(manifest['nodes']['008010:M1X0']['disposition'], 'aot_eligible')
+            deferred = manifest['nodes']['008020:M1X1']
+            self.assertEqual(deferred['disposition'], 'lle_only')
+            self.assertIn('forced_lle_variant', deferred['reasons'])
+            caller = manifest['nodes']['008000:M1X0']
+            edge = next(e for e in caller['demands'] if e['target'] and e['target']['pc24'] == 0x8010 and e['target']['x'] == 1)
+            self.assertEqual(edge['resolution'], 'lle_exact')
+            dispatch = (out / 'dispatch_v2.c').read_text()
+            row = next(line for line in dispatch.splitlines() if '{ 0x008010u,' in line)
+            self.assertIn('{ NULL, NULL, Shared_M1X0, NULL }', row)
+            bank = (out / 'bank00_v2.c').read_text()
+            self.assertIn('RecompReturn Shared_M1X0(CpuState *cpu) {', bank)
+            self.assertNotIn('RecompReturn Shared_M1X1(CpuState *cpu) {', bank)
+
+
+if __name__ == '__main__':
+    unittest.main()
