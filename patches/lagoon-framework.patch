diff --git a/runner/src/cpu_state.h b/runner/src/cpu_state.h
index f9b1e26..78f8740 100644
--- a/runner/src/cpu_state.h
+++ b/runner/src/cpu_state.h
@@ -417,6 +417,27 @@ void   cpu_write16(CpuState *cpu, uint8 bank, uint16 addr, uint16 v);
  * interpreter's bridge shims use the plain accessors (they account
  * transfers themselves). */
 uint32_t  cpu_region_speed(uint32_t adr);
+/* Precise-root codegen already charges six clocks per CPU cycle. These
+ * accessors add only the addressed bus region's excess over that baseline.
+ * ABI bookkeeping outside emitted instruction bodies stays unpaced. */
+static inline uint8 cpu_read8_timed(CpuState *cpu, uint8 bank, uint16 addr) {
+    cpu->master_cycles += cpu_region_speed(((uint32)bank << 16) | addr) - 6;
+    return cpu_read8(cpu, bank, addr);
+}
+static inline uint16 cpu_read16_timed(CpuState *cpu, uint8 bank, uint16 addr) {
+    cpu->master_cycles += cpu_region_speed(((uint32)bank << 16) | addr) - 6;
+    cpu->master_cycles += cpu_region_speed(((uint32)bank << 16) | (uint16)(addr + 1)) - 6;
+    return cpu_read16(cpu, bank, addr);
+}
+static inline void cpu_write8_timed(CpuState *cpu, uint8 bank, uint16 addr, uint8 v) {
+    cpu->master_cycles += cpu_region_speed(((uint32)bank << 16) | addr) - 6;
+    cpu_write8(cpu, bank, addr, v);
+}
+static inline void cpu_write16_timed(CpuState *cpu, uint8 bank, uint16 addr, uint16 v) {
+    cpu->master_cycles += cpu_region_speed(((uint32)bank << 16) | addr) - 6;
+    cpu->master_cycles += cpu_region_speed(((uint32)bank << 16) | (uint16)(addr + 1)) - 6;
+    cpu_write16(cpu, bank, addr, v);
+}
 /* SNESRECOMP_WLOG_ADDR hook for direct-WRAM stores that bypass cpu_write8/16
  * (DMA A-bus writes in snes_write, WMDATA $2180). wa = g_ram offset. */
 void wlog_addr_note_direct(uint32_t wa, uint8_t v, const char *via);
