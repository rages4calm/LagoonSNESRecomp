diff --git a/tests/ppu/ppu_raster_state_test.c b/tests/ppu/ppu_raster_state_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..e68f988d47c7b38d7cde7239c67ce278c5216f45
--- /dev/null
+++ b/tests/ppu/ppu_raster_state_test.c
@@ -0,0 +1,114 @@
+/* ROM-free raster continuation test. The PPU body alone cannot reproduce
+ * a cold-process restore: both completed and overshooting journals are needed. */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "snes/ppu.h"
+#include "snes/snes.h"
+Snes *g_snes;
+int snes_frame_counter;
+unsigned char g_snesrecomp_last_hdmaen;
+uint16_t WsShadowTile(int layer, int x, uint32_t y, uint16_t tile) {
+  (void)layer; (void)x; (void)y; return tile;
+}
+bool WsShadowLayerActive(int layer) { (void)layer; return false; }
+uint32_t WsShadowWorldX(int layer) { (void)layer; return 0; }
+uint32_t WsShadowPresentWorldY(int layer, int x) { (void)layer; (void)x; return 0; }
+uint32_t WsShadowScrollY(int layer) { (void)layer; return 0; }
+void WsShadowOnVramWrite(uint16_t address, uint16_t value) { (void)address; (void)value; }
+
+
+static Snes machine;
+static Ppu p, saved_body;
+static void write_at(unsigned line, uint8_t reg, uint8_t value) {
+  machine.vPos=(uint16_t)line; ppu_write(&p,reg,value);
+}
+typedef struct { uint8_t brightness,left,right,prev,oam,pending,hdma; } Sample;
+static Sample sample(void) {
+  Sample s={p.inidisp,p.window1left,p.window1right,p.scrollPrev,p.oamAdr,0,0};
+  s.pending=(uint8_t)ppu_rasterTakeHdmaen(&s.hdma); return s;
+}
+static void replay(Sample result[14]) {
+  static const int lines[]={0,21,22,198,199};
+  unsigned n=0;
+  for (int field=0;field<2;field++) {
+    ppu_rasterRenderBegin(&p); result[n++]=sample();
+    for (unsigned i=0;i<5;i++) { ppu_rasterApplyLine(&p,lines[i]); result[n++]=sample(); }
+    ppu_rasterApplyLine(&p,224); ppu_rasterRenderEnd(&p); result[n++]=sample();
+    machine.vPos=225; ppu_rasterFieldBoundary();
+  }
+  assert(n==14);
+}
+static void put32(uint8_t *p,uint32_t value) {
+  for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(value>>(i*8));
+}
+int main(void) {
+  g_snes=&machine; machine.ppu=&p; ppu_reset(&p); ppu_rasterReset();
+  size_t empty_size=ppu_raster_state_size(); uint8_t *empty=malloc(empty_size);
+  assert(empty); ppu_raster_state_save(empty); assert(ppu_raster_state_valid(empty,empty_size));
+  assert(ppu_raster_state_load(empty,empty_size));
+  assert(!ppu_raster_state_valid(NULL,empty_size));
+  assert(!ppu_raster_state_valid(empty,empty_size-1));
+  free(empty);
+  write_at(225,0x00,0x80); write_at(225,0x26,0xFF); ppu_rasterBegin(&p);
+  write_at(230,0x00,15); ppu_rasterRecord(0x420C,230,3);
+  write_at(22,0x26,0x14); write_at(22,0x27,0xEB);
+  write_at(199,0x00,0x80); write_at(199,0x26,0xFF);
+  machine.vPos=225; ppu_rasterFieldBoundary();
+  /* Pending writes AFTER the field ended: dropping these corrupts the guest
+   * register file restored at RenderEnd and the following field's replay. */
+  write_at(230,0x00,7); write_at(10,0x26,0x20); write_at(12,0x02,0x40);
+  p.oamAdr=0x41; p.scrollPrev=0x6D; saved_body=p;
+  size_t size=ppu_raster_state_size(); uint8_t *blob=malloc(size),*bad=malloc(size+1),*after=malloc(size);
+  assert(blob&&bad&&after); ppu_raster_state_save(blob); assert(ppu_raster_state_valid(blob,size));
+  Sample baseline[14],restored[14]; replay(baseline);
+  assert(baseline[1].brightness==15 && baseline[1].pending && baseline[1].hdma==3);
+  assert(baseline[3].left==0x14 && baseline[5].brightness==0x80);
+  assert(baseline[6].brightness==7 && baseline[6].left==0x20 && baseline[6].oam==0x41);
+  /* A new process has cold registers/journals, not the warm last game's. */
+  ppu_rasterReset(); ppu_reset(&p); write_at(225,0x00,0x80); ppu_rasterBegin(&p);
+  assert(ppu_raster_state_load(blob,size));
+  assert(p.inidisp==0x80); /* API never restores the separately saved PPU body. */
+  p=saved_body; replay(restored); assert(!memcmp(baseline,restored,sizeof(baseline)));
+  /* Loading also clears a partially consumed replay/HDMA notification. */
+  assert(ppu_raster_state_load(blob,size)); p=saved_body;
+  ppu_rasterRenderBegin(&p); ppu_rasterApplyLine(&p,0);
+  assert(ppu_raster_state_load(blob,size)); uint8_t hdma=0xAA;
+  assert(!ppu_rasterTakeHdmaen(&hdma));
+  p=saved_body; replay(restored); assert(!memcmp(baseline,restored,sizeof(baseline)));
+  /* Every malformed load is rejected before changing either journal. */
+  assert(ppu_raster_state_load(blob,size));
+  for(unsigned mutation=0;mutation<10;mutation++) {
+    memcpy(bad,blob,size); size_t supplied=size;
+    switch(mutation) {
+      case 0: bad[0]^=1; break;
+      case 1: bad[4]=2; break;
+      case 2: bad[12]=2; break;
+      case 3: bad[13]=2; break;
+      case 4: bad[14]=2; break;
+      case 5: bad[15]=1; break;
+      case 6: put32(bad+16+PPU_SAVESTATE_REGS_SIZE+4,4097); break;
+      case 7: bad[16+PPU_SAVESTATE_REGS_SIZE+12]=6; bad[17+PPU_SAVESTATE_REGS_SIZE+12]=1; break; /* key262 */
+      case 8: bad[18+PPU_SAVESTATE_REGS_SIZE+12]=0x18; bad[19+PPU_SAVESTATE_REGS_SIZE+12]=0x21; break; /* upload port2118 */
+      case 9: supplied=size+1; put32(bad+8,(uint32_t)supplied); break;
+    }
+    assert(!ppu_raster_state_valid(bad,supplied)); assert(!ppu_raster_state_load(bad,supplied));
+    assert(ppu_raster_state_size()==size); ppu_raster_state_save(after); assert(!memcmp(after,blob,size));
+  }
+  assert(!ppu_raster_state_load(blob,size-1));
+  /* Capacity and dropped-write accounting survive without stale array tails. */
+  ppu_rasterReset(); ppu_rasterBegin(&p);
+  for(unsigned i=0;i<4097;i++) ppu_rasterRecord(0x2100,230,15);
+  size_t full_size=ppu_raster_state_size(); uint8_t *full=malloc(full_size),*full_copy=malloc(full_size);
+  assert(full&&full_copy); ppu_raster_state_save(full);
+  assert(ppu_raster_state_valid(full,full_size));
+  assert(ppu_raster_state_load(full,full_size));
+  ppu_raster_state_save(full_copy); assert(!memcmp(full,full_copy,full_size));
+  assert(full[16+PPU_SAVESTATE_REGS_SIZE+8]==1); /* dropped count */
+  put32(full+16+PPU_SAVESTATE_REGS_SIZE+4,0xFFFFFFFFu);
+  assert(!ppu_raster_state_load(full,full_size));
+  free(full);free(full_copy);
+  free(blob);free(bad);free(after);
+  puts("ppu_raster_state_test: PASS fresh/cold restore, two-field replay, V225 overshoot, latches/HDMA, transient reset, atomic malformed rejection");return 0;
+}
diff --git a/tests/ppu/ppu_shadow_authoritative_map_test.c b/tests/ppu/ppu_shadow_authoritative_map_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..1f7c676d5232c32cbc7190abf54ccae4ca29a602
--- /dev/null
+++ b/tests/ppu/ppu_shadow_authoritative_map_test.c
@@ -0,0 +1,62 @@
+/* Actual shadow storage + actual PPU: a captured circular-map blank must
+ * yield to a title-resolved retained map, while native pixels stay authentic. */
+#define main unused_world_mirror_main
+#define WsShadowTile fixture_WsShadowTile
+#define WsShadowLayerActive fixture_WsShadowLayerActive
+#define WsShadowWorldX fixture_WsShadowWorldX
+#define WsShadowPresentWorldY fixture_WsShadowPresentWorldY
+#define WsShadowScrollY fixture_WsShadowScrollY
+#define WsShadowOnVramWrite fixture_WsShadowOnVramWrite
+#include "ppu_world_mirror_test.c"
+#undef main
+#undef WsShadowTile
+#undef WsShadowLayerActive
+#undef WsShadowWorldX
+#undef WsShadowPresentWorldY
+#undef WsShadowScrollY
+#undef WsShadowOnVramWrite
+#include "snes/ws_shadow.h"
+
+int main(void) {
+  Ppu *p = calloc(1, sizeof(*p));
+  uint32_t pixels[kWide];
+  check(p != NULL, "allocate PPU");
+  ppu_reset(p);
+  PpuBeginDrawing(p, (uint8_t *)pixels, sizeof(uint32_t) * kWide,
+                  kPpuRenderFlags_NewRenderer);
+  setup_arena_bg1(p);
+  for (int i = 0; i < 0x1000; ++i) p->vram[i] = 1;
+  int native[8], resolved[8];
+  for (int x = 0; x < 8; ++x) { native[x] = 1; resolved[x] = 5; }
+  for (int y = 0; y < 8; ++y) {
+    put_tile_row(p, 1, y, native); put_tile_row(p, 2, y, resolved);
+  }
+  PpuSetExtraSpace(p, kExtra);
+  PpuSetWidescreenShadowNativeExactMask(p, 1);
+  WsShadowReset(); WsShadowSetWorld(0, 0, 0); WsShadowFrame(p);
+  /* Native column35 is circular-buffer headroom, not a proven world tile. */
+  p->vram[0x403] = 0;
+  WsShadowOnVramWrite(0x403, 0);
+  uint16_t tile = 999;
+  check(WsShadowLookupWorldTile(0, 35, 0, &tile) && tile == 0,
+        "real VRAM capture reproduces blank history");
+  WsShadowPrefillTile(0, 35, 0, 2);
+  check(WsShadowLookupWorldTile(0, 35, 0, &tile) && tile == 0,
+        "default prefill preserves captured entries for existing ports");
+  WsShadowForceTile(0, 35, 0, 2);
+  WsShadowForceTile(0, 1, 0, 2); /* deliberately differs under native view */
+  check(WsShadowLookupWorldTile(0, 35, 0, &tile) && tile == 2,
+        "opt-in authoritative map replaces circular blank");
+  ppu_runLine(p, 0); ppu_runLine(p, 1);
+  check(pixels[kExtra + 280] == 0x292929, "resolved right-margin pixel has exact retained palette color");
+  check(pixels[kExtra + 8] == 0x080808, "native fragment retains exact guest palette color");
+  check(pixels[kExtra + 280] != pixels[kExtra + 8],
+        "native fragment uses actual VRAM despite authoritative shadow difference");
+  check(WsShadowTile(0, 8, 0, 0, 1, 1) == 1,
+        "native tile lookup remains actual guest tile");
+  WsShadowReset();
+  check(!WsShadowLookupWorldTile(0, 35, 0, &tile), "reset clears authoritative history");
+  free(p);
+  puts("authoritative retained map: captured blank reproduction, unchanged default, real PPU margin/native pixels, reset PASS");
+  return 0;
+}
diff --git a/tests/ppu/ppu_shadow_native_boundary_test.c b/tests/ppu/ppu_shadow_native_boundary_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..34874807f8ccf78babeb2f69f8a40d7e815fc712
--- /dev/null
+++ b/tests/ppu/ppu_shadow_native_boundary_test.c
@@ -0,0 +1,100 @@
+/* Reuse the ROM-free world-mirror fixture and its peripheral stubs. The
+ * linked ppu.c remains the real renderer. Override only its shadow provider
+ * with deliberately different native/retained map tiles. */
+#define main world_mirror_fixture_main
+#define WsShadowTile inactive_fixture_shadow_tile
+#define WsShadowLayerActive inactive_fixture_shadow_layer
+#include "ppu_world_mirror_test.c"
+#undef main
+#undef WsShadowTile
+#undef WsShadowLayerActive
+
+static bool shadow_active;
+static const uint8_t *host_policy_address;
+static size_t serialized_bytes;
+static unsigned serialized_chunks;
+
+static void audit_serialized_range(SaveLoadInfo *info, void *data, size_t size) {
+    (void)info;
+    uintptr_t start = (uintptr_t)data, policy = (uintptr_t)host_policy_address;
+    check(!(policy >= start && policy - start < size),
+          "host-only exact-native mask is excluded from serialized ranges");
+    serialized_bytes += size;
+    serialized_chunks++;
+}
+bool WsShadowLayerActive(int layer) { return shadow_active && layer == 0; }
+uint16_t WsShadowTile(int layer, int x, uint32_t y, uint16_t scroll,
+                     uint16_t adr, uint16_t real_tile) {
+    (void)layer; (void)y; (void)scroll; (void)adr;
+    return x >= 0 && x + 8 <= 256 ? real_tile : 2;
+}
+
+static void render_boundary(Ppu *ppu, uint32_t *out, int phase,
+                            bool shadow, bool exact, bool sub) {
+    ppu_reset(ppu);
+    PpuBeginDrawing(ppu, (uint8_t *)out, sizeof(uint32_t) * kWide,
+                    kPpuRenderFlags_NewRenderer);
+    setup_arena_bg1(ppu);
+    for (int i = 0; i < 0x1000; ++i) ppu->vram[i] = 1;
+    for (int row = 0; row < 8; ++row) {
+        int native[8], retained[8];
+        for (int x = 0; x < 8; ++x) {
+            native[x] = 1 + x % 3;
+            retained[x] = 5 + x % 3;
+        }
+        put_tile_row(ppu, 1, row, native);
+        put_tile_row(ppu, 2, row, retained);
+    }
+    if (sub) {
+        ppu->screenEnabled[0] = 0;
+        ppu->screenEnabled[1] = 1;
+        ppu->cgwsel = 2; /* real subscreen */
+        ppu->cgadsub = 0x20; /* add subscreen to backdrop */
+    }
+    PpuSetExtraSpace(ppu, kExtra);
+    if (exact) PpuSetWidescreenShadowNativeExactMask(ppu, 1);
+    shadow_active = shadow;
+    ppu->hScroll[0] = (uint16_t)phase;
+    ppu_runLine(ppu, 0);
+    ppu->hScroll[0] = (uint16_t)phase;
+    ppu_runLine(ppu, 1);
+}
+
+int main(void) {
+    Ppu *ppu = calloc(1, sizeof(*ppu));
+    uint32_t native[kWide], legacy[kWide], exact[kWide];
+    int regression_witnesses = 0;
+    if (!ppu) return 2;
+    for (int sub = 0; sub < 2; ++sub)
+            for (int phase = 0; phase < 8; ++phase) {
+                render_boundary(ppu, native, phase, false, false, sub);
+                render_boundary(ppu, legacy, phase, true, false, sub);
+                render_boundary(ppu, exact, phase, true, true, sub);
+                for (int x = 0; x < 256; ++x) {
+                    check(exact[kExtra + x] == native[kExtra + x],
+                          "exact shadow policy preserves every native pixel");
+                    if (legacy[kExtra + x] != native[kExtra + x]) regression_witnesses++;
+                }
+                bool margin_changed = false;
+                for (int x = 0; x < kWide; ++x)
+                    if (x < kExtra || x >= kExtra + 256) {
+                        margin_changed |= exact[x] != native[x];
+                        check(exact[x] == legacy[x], "existing shadow margin pixels remain unchanged");
+                    }
+                check(margin_changed, "retained-map margin still renders");
+            }
+    check(regression_witnesses > 0, "fixture reproduces legacy native-boundary corruption");
+    PpuSetWidescreenShadowNativeExactMask(ppu, 3);
+    PpuSetExtraSpace(ppu, kExtra);
+    check(ppu->wsShadowNativeExactMask == 0, "policy is opt-in each frame");
+    SaveLoadInfo save = { .func = audit_serialized_range };
+    host_policy_address = &ppu->wsShadowNativeExactMask;
+    ppu_saveload(ppu, &save);
+    check(serialized_chunks == 3, "PPU snapshot keeps its three explicit chunks");
+    check(serialized_bytes == 8 + PPU_SAVESTATE_REGS_SIZE + PPU_SAVESTATE_MEM_SIZE,
+          "PPU serialized byte count remains backward compatible");
+    free(ppu);
+    if (failures) return 1;
+    puts("ppu_shadow_native_boundary_test: PASS (8 scroll phases, main/subscreen, real margins)");
+    return 0;
+}
