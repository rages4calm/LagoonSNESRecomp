diff --git a/runner/src/snes/aot_deny_key.h b/runner/src/snes/aot_deny_key.h
new file mode 100644
index 0000000000000000000000000000000000000000..3bce15cf9628331e4bc0ad32a3de6b983b19b71f
--- /dev/null
+++ b/runner/src/snes/aot_deny_key.h
@@ -0,0 +1,35 @@
+/* Exact-mode target keys for opt-in AOT differential denial. */
+#ifndef SNESRECOMP_AOT_DENY_KEY_H
+#define SNESRECOMP_AOT_DENY_KEY_H
+#include <ctype.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <errno.h>
+static inline uint32_t aot_deny_variant_key(uint32_t pc, unsigned m, unsigned x) {
+    return 0x10000000u | ((pc & 0xffffffu) << 2) | ((m & 1u) << 1) | (x & 1u);
+}
+/* 1 valid token, 0 blank/comment, -1 malformed. Plain PCs keep all-mode meaning. */
+static inline int aot_deny_parse_key(const char *line, uint32_t *out) {
+    while (isspace((unsigned char)*line)) line++;
+    if (!*line || *line == '#') return 0;
+    if (*line == '-' || *line == '+') return -1;
+    errno = 0;
+    char *end;
+    unsigned long pc = strtoul(line, &end, 16);
+    if (errno || end == line || pc > 0xfffffful) return -1;
+    uint32_t key = (uint32_t)pc;
+    if (*end == ':') {
+        end++;
+        if ((end[0] != 'M' && end[0] != 'm') ||
+            (end[1] != '0' && end[1] != '1') ||
+            (end[2] != 'X' && end[2] != 'x') ||
+            (end[3] != '0' && end[3] != '1')) return -1;
+        key = aot_deny_variant_key(key, (unsigned)(end[1]-'0'), (unsigned)(end[3]-'0'));
+        end += 4;
+    }
+    while (isspace((unsigned char)*end)) end++;
+    if (*end && *end != '#') return -1;
+    *out = key;
+    return 1;
+}
+#endif
