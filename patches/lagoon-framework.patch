+"""Callback bus authority: compile the actual helper, delegate all bus semantics."""
+from pathlib import Path
+import runpy,subprocess,shutil
+
+def test_callback_source_read(tmp_path):
+ sdk=Path(__file__).resolve().parents[1]
+ text=(sdk/'runner/src/snes/interp_bridge.c').read_text(encoding='utf8')
+ function=runpy.run_path(str(sdk/'tests/test_source_opcode_commit.py'))['function']
+ actual='\n'.join(function(text,n)for n in ['interp_bridge_source_opcode_available','interp_bridge_source_read8'])
+ harness=r"""
+#include <stdint.h>
+#include <stdbool.h>
+#include <assert.h>
+#include <stdio.h>
+typedef struct {uint64_t master_cycles;uint8_t open_bus;} CpuState;
+static CpuState g_cpu,other;
+static const CpuState*s_pre_opcode_callback_cpu;
+static int s_pre_opcode_callback_can_yield,s_interp_bus_timing_active;
+static uint64_t s_lle_master_deadline;
+static struct {void*apu;} machine,*g_snes;
+static unsigned calls,volatile_reads,progress,pending,observed_pending;
+static uint8_t bridge_bus_read(void*cpu,uint32_t address){
+ assert(cpu==&g_cpu&&address==0x2140&&!s_interp_bus_timing_active);
+ calls++;volatile_reads++;progress++;observed_pending=pending;pending=0;
+ return g_cpu.open_bus=(uint8_t)(calls*17);
+}
+"""+actual+r"""
+static void setup(void){g_cpu=(CpuState){100,99};g_snes=&machine;machine.apu=(void*)1;s_pre_opcode_callback_cpu=&g_cpu;s_pre_opcode_callback_can_yield=1;s_lle_master_deadline=5000;s_interp_bus_timing_active=1;calls=volatile_reads=progress=observed_pending=0;pending=123;}
+int main(void){
+ for(unsigned active=0;active<2;active++){setup();s_interp_bus_timing_active=active;
+ for(unsigned n=1;n<10;n++){uint8_t out=0;pending=n*9;assert(interp_bridge_source_read8(&g_cpu,0x2140,&out));assert(out==n*17&&g_cpu.open_bus==out&&calls==n&&volatile_reads==n&&progress==n&&observed_pending==n*9&&!pending&&s_interp_bus_timing_active==(int)active&&g_cpu.master_cycles==100);}}
+ for(unsigned n=0;n<10;n++){setup();CpuState*c=&g_cpu;uint32_t address=0x2140;uint8_t out=88,*dest=&out;
+ if(n==0)c=0;if(n==1)c=&other;if(n==2)s_pre_opcode_callback_cpu=0;if(n==3)s_pre_opcode_callback_can_yield=0;if(n==4)s_lle_master_deadline=0;if(n==5)machine.apu=0;if(n==6)g_snes=0;if(n==7)address=0x1000000;if(n==8)dest=0;if(n==9)s_pre_opcode_callback_cpu=&other;
+ assert(!interp_bridge_source_read8(c,address,dest));assert(out==88&&g_cpu.open_bus==99&&g_cpu.master_cycles==100&&!calls&&!volatile_reads&&!progress&&pending==123&&s_interp_bus_timing_active==1);}
+ puts("PASS18 callback bus reads,10 immutable authority/address/output refusals");return 0;}
+"""
+ source=tmp_path/'source_bus.c';source.write_text(harness,encoding='utf8');exe=tmp_path/'source-bus.exe'
+ subprocess.run([shutil.which('clang')or'cc','-std=c11','-O2',str(source),'-o',str(exe)],check=True)
+ result=subprocess.run([str(exe)],check=True,capture_output=True,text=True);print(result.stdout,end='');assert 'PASS18' in result.stdout
