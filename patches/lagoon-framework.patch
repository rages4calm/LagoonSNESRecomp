+++ b/runner/src/native_blocks.h
@@ -0,0 +1,135 @@
+#ifndef SNESRECOMP_NATIVE_BLOCKS_H
+#define SNESRECOMP_NATIVE_BLOCKS_H
+
+/* Additive architectural native-block ABI. These callbacks do not admit an
+ * interpreter source callback or manufacture a paired host return frame. */
+#include "cpu_state.h"
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct NativeBlockKey {
+    uint32_t pc24;
+    uint32_t profile;
+    uint8_t m, x, e;
+} NativeBlockKey;
+
+typedef enum NativeBlockAction {
+    NATIVE_BLOCK_CONTINUE = 0,
+    NATIVE_BLOCK_DEADLINE,
+    NATIVE_BLOCK_MISSING,
+    NATIVE_BLOCK_REJECTED,
+    NATIVE_BLOCK_STEP_LIMIT,
+    NATIVE_BLOCK_WAI,
+    NATIVE_BLOCK_STP,
+    NATIVE_BLOCK_INTERRUPT
+} NativeBlockAction;
+
+typedef enum NativeBlockFault {
+    NATIVE_BLOCK_FAULT_NONE = 0,
+    NATIVE_BLOCK_FAULT_ABI,
+    NATIVE_BLOCK_FAULT_MODE,
+    NATIVE_BLOCK_FAULT_SOURCE,
+    NATIVE_BLOCK_FAULT_MAPPING,
+    NATIVE_BLOCK_FAULT_CONTEXT
+} NativeBlockFault;
+
+typedef struct NativeBlockResult {
+    NativeBlockKey next;
+    NativeBlockAction action;
+    NativeBlockFault fault;
+    uint64_t executed;
+} NativeBlockResult;
+
+struct NativeBlockScope;
+typedef void (*NativeBlockFunction)(CpuState*, struct NativeBlockScope*);
+
+typedef enum NativeBlockTransfer {
+    NATIVE_BLOCK_TRANSFER_NONE = 0,
+    NATIVE_BLOCK_TRANSFER_BRANCH,
+    NATIVE_BLOCK_TRANSFER_JUMP,
+    NATIVE_BLOCK_TRANSFER_CALL_SHORT,
+    NATIVE_BLOCK_TRANSFER_CALL_LONG,
+    NATIVE_BLOCK_TRANSFER_RETURN_SHORT,
+    NATIVE_BLOCK_TRANSFER_RETURN_LONG,
+    NATIVE_BLOCK_TRANSFER_RETURN_INTERRUPT
+} NativeBlockTransfer;
+typedef struct NativeBlockInstruction {
+    NativeBlockKey key;
+    uint32_t rom_offset;
+    uint16_t base_cpu_cycles;
+    uint8_t length;
+    uint8_t bytes[4];
+    uint8_t required_p_mask, required_p_value;
+    NativeBlockFunction execute;
+    NativeBlockTransfer transfer;
+} NativeBlockInstruction;
+
+struct NativeBlockProgram;
+typedef struct NativeBlockHost {
+    void *context;
+    /* Refuse BEFORE any guest state changes. Bind the primary CPU, original
+     * source image/profile and generation. Mapping checks every fetch byte
+     * against its actual current physical mapping and exact expected value.
+     * Refused predicates must not mutate guest state or clocks. */
+    bool (*admit)(void*, const struct NativeBlockProgram*, CpuState*, const NativeBlockInstruction*);
+    bool (*mapping)(void*, CpuState*, const NativeBlockInstruction*);
+    /* Bus operations are total once admitted. They preserve actual device
+     * effects/stalls. The generated scope owns regional data-access extras;
+     * these callbacks MUST NOT charge those CPU bus cycles a second time. */
+    uint8_t (*read8)(void*, CpuState*, uint32_t address);
+    void (*write8)(void*, CpuState*, uint32_t address, uint8_t value);
+    uint32_t (*region_speed)(void*, uint32_t address);
+    /* Publish/restore exact source read context and timing epoch. begin/end
+     * are observers: they must not execute a guest instruction or charge it.
+     * commit runs ONCE after the full actual instruction. opcode_master is
+     * CPU/fetch/data time only; device stalls already on CpuState are not
+     * repriced or added to this value. commit owns refresh, beam/coproc/APU
+     * cadence and progress/write epochs, using its valid native capability. */
+    void (*begin)(void*, CpuState*, const NativeBlockInstruction*, uint64_t prior_master);
+    void (*commit)(void*, CpuState*, const NativeBlockInstruction*, uint64_t prior_master,
+                   uint64_t opcode_master, bool wrote_memory);
+    void (*end)(void*, CpuState*, const NativeBlockInstruction*);
+    /* Optional atomic word bus path, with the same contract as the original
+     * bus read_word callback. False means NO effects occurred and the emitted
+     * scope must fall back to two ordered byte reads. True preserves actual
+     * atomic device behavior; regional extras remain owned by the scope. */
+    bool (*read16)(void*, CpuState*, uint32_t low, uint32_t high, uint16_t *value);
+    bool (*write16)(void*, CpuState*, uint32_t low, uint32_t high, uint16_t value, bool reversed);
+} NativeBlockHost;
+
+typedef struct NativeBlockScope {
+    const NativeBlockHost *host;
+    const NativeBlockInstruction *instruction;
+    uint64_t prior_master, data_extra;
+    uint32_t cpu_cycles, next_pc24;
+    NativeBlockAction action;
+    bool wrote_memory;
+} NativeBlockScope;
+
+/* Explicit approved source overlay. The original input is still attested by
+ * source_sha256; registration verifies every original byte and derives each
+ * descriptor's runtime bytes only through these nonoverlapping spans. Bind
+ * and per-op mapping checks retain the exact expected runtime bytes. */
+typedef struct NativeBlockPatch {
+    uint32_t rom_offset;
+    uint32_t length;
+    const uint8_t *original_bytes;
+    const uint8_t *runtime_bytes;
+} NativeBlockPatch;
+
+typedef struct NativeBlockProgram {
+    const char *name;
+    const char *source_sha256;
+    uint32_t profile;
+    const NativeBlockInstruction *instructions;
+    size_t instruction_count;
+    NativeBlockResult (*step)(const struct NativeBlockProgram*, const NativeBlockHost*,
+                              CpuState*, NativeBlockKey, uint64_t deadline);
+    NativeBlockResult (*run)(const struct NativeBlockProgram*, const NativeBlockHost*,
+                             CpuState*, NativeBlockKey, uint64_t deadline, uint64_t step_limit);
+    const NativeBlockPatch *patches;
+    size_t patch_count;
+} NativeBlockProgram;
+
+#endif
