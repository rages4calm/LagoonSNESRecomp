+"""Regression for opt-in native roots sharing interpreter instruction boundaries."""
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'recompiler'))
+from v2.emit_function import emit_function, _precise_root_enabled
+
+
+class PreciseTimingChecks(unittest.TestCase):
+    def emit(self,roots,m=0,x=0):
+        rom=bytearray(0x100000)
+        # LDA abs,X; CLC; ADC abs,X; STA abs,X; RTS. Native M0/X0.
+        rom[0x8000:0x800b]=bytes.fromhex('bd0205187d06059d020560')
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':roots}):
+            return emit_function(bytes(rom),1,0x8000,m,x)
+
+    def test_exact_variant_preserves_nonmatching_historical_coarse_body(self):
+        coarse=self.emit('')
+        self.assertEqual(self.emit('018000:M1X1'),coarse)
+        self.assertEqual(self.emit('018000:M0X0'),self.emit('018000'))
+        self.assertEqual(self.emit('018000:M1X1',1,1),self.emit('018000',1,1))
+        self.assertEqual(self.emit('018000:M1X0',1,1),self.emit('',1,1))
+
+    def test_mixed_tokens_and_legacy_hex_syntax(self):
+        for tokens in ('018000,028000', '0x018000\n028000:M1X1',
+                       '028000:M1X0, 018000:M0X0', '018000:m0x0'):
+            self.assertEqual(self.emit(tokens),self.emit('018000'))
+        for m in (0,1):
+            for x in (0,1):
+                self.assertTrue(_precise_root_enabled('018000',0x018000,m,x))
+                self.assertEqual(self.emit('018000',m,x),self.emit('0x018000,028000',m,x))
+
+    def test_invalid_variant_fails_closed_even_after_matching_token(self):
+        for token in ('018000:M2X0','018000:M0X2','018000:M0',
+                      '018000:M00X0','018000:M0X0:extra','1000000:M0X0',
+                      '-1:M0X0',':M0X0','018000:','018000:foo'):
+            with self.subTest(token=token),self.assertRaises(ValueError):
+                self.emit('018000,'+token)
+
+    def test_precise_root_yields_at_every_instruction(self):
+        source=self.emit('018000')
+        self.assertEqual(source.count('cpu_trace_block(cpu,'),5)
+        self.assertIn('cpu_read16_timed(cpu,',source)
+        self.assertIn('cpu_write16_timed(cpu,',source)
+        # Fetch/internal baseline: LDA abs,X M0X0 = 6 cycles, 3 fetch bytes.
+        self.assertIn('cpu->master_cycles += 36 + 3 * (',source)
+        # ABI return-address inspection is host bookkeeping, not guest traffic.
+        prologue=source.split('cpu_trace_block(cpu,')[0]
+        self.assertIn('cpu_read8(cpu,',prologue)
+        self.assertNotIn('cpu_read8_timed(cpu,',prologue)
+
+    def test_other_roots_retain_existing_model(self):
+        for roots in ('','028000'):
+            source=self.emit(roots)
+            self.assertEqual(source.count('cpu_trace_block(cpu,'),1)
+            self.assertNotIn('_timed(cpu,',source)
+
+    def test_long_indirect_store_reads_pointer_once(self):
+        rom=bytearray(0x100000)
+        rom[0x8000:0x8003]=bytes.fromhex('974060') # STA [$40],Y; RTS
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':'018000'}):
+            source=emit_function(bytes(rom),1,0x8000,0,0)
+        self.assertEqual(source.count('cpu_read16_timed(cpu,'),1)
+        self.assertIn('_ea = (_ea + (uint32)cpu->Y) & 0xFFFFFFu;',source)
+        self.assertEqual(source.count('cpu_write16_timed(cpu,'),1)
+        self.assertIn('cpu_instruction_timing_commit(cpu);',source)
+
+    def test_unresolved_indirect_jump_is_charged_only_by_interpreter(self):
+        rom=bytearray(0x100000)
+        # A real native LDA followed by an unresolved JMP ($1234).
+        rom[0x8000:0x8006]=bytes.fromhex('a9016c3412ea')
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':'018000'}):
+            source=emit_function(bytes(rom),1,0x8000,1,0)
+        first,jump=source.split('  L_8002_M1X0:')
+        self.assertIn('cpu->cycles += 2;',first)
+        self.assertIn('cpu->master_cycles += 12 + 2 * (',first)
+        self.assertIn('unresolved IndirectGoto -> interpreter tier',jump)
+        self.assertNotIn('cpu->cycles +=',jump)
+        self.assertNotIn('cpu->master_cycles +=',jump)
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':''}):
+            coarse=emit_function(bytes(rom),1,0x8000,1,0)
+        # Historical aggregate blocks remain unchanged during staged adoption.
+        self.assertIn('cpu->cycles += 7;',coarse)
+
+    def test_balanced_terminal_jump_also_delegates_instruction_timing(self):
+        rom=bytearray(0x100000)
+        rom[0x8000:0x8003]=bytes.fromhex('6c3412')
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':'018000'}):
+            source=emit_function(bytes(rom),1,0x8000,1,0,
+                                 hle_dispatch={0x8000:'__balanced_interp__'})
+        self.assertIn('balanced_interp_dispatch',source)
+        self.assertNotIn('cpu->cycles +=',source)
+        self.assertNotIn('cpu->master_cycles +=',source)
+
+    def test_opt_in_native_transfer_commits_after_jsl_frame(self):
+        from v2 import codegen
+        rom=bytearray(0x100000)
+        rom[0x8000:0x8005]=bytes.fromhex('2200810160') # JSL $01:8100; RTS
+        rom[0x8100]=0x6b
+        def emit(transfers,precise='018000'):
+            with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':precise,
+                    'SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS':transfers}), \
+                 patch.object(codegen,'_NAME_RESOLVER',{0x018100:'TransferTarget'}), \
+                 patch.object(codegen,'_VALID_VARIANTS',{0x018100:{(1,0)}}), \
+                 patch.object(codegen,'_VALID_VARIANTS_AUTHORITATIVE',True):
+                return emit_function(bytes(rom),1,0x8000,1,0)
+        legacy=emit('')
+        self.assertEqual(emit('028000:M1X0'),legacy)
+        opted=emit('018000:M1X0')
+        call='(cpu_instruction_timing_commit(cpu), TransferTarget_M1X0(cpu))'
+        self.assertIn(call,opted)
+        from v2.translation_units import _with_referenced_variant_declarations
+        from v2.link_closure import _CALL_RE
+        declared=_with_referenced_variant_declarations(
+            '/* Forward declarations for in-bank entries. */\n'+opted)
+        self.assertIn('RecompReturn TransferTarget_M1X0(CpuState *cpu);',declared)
+        self.assertIn('TransferTarget_M1X0',_CALL_RE.findall(opted))
+        self.assertLess(opted.index('cpu_write8_timed(cpu, 0x00, cpu->S'),opted.index(call))
+        self.assertLess(opted.index('cpu->host_return_valid = 3;'),opted.index(call))
+        self.assertIn('TransferTarget_M1X0(cpu)',legacy)
+        self.assertNotIn(call,emit('018000:M1X0',precise=''))
+
+    def test_opt_in_native_tail_transfer_commits_without_extra_cycles(self):
+        from v2 import codegen
+        rom=bytearray(0x100000)
+        rom[0x8000:0x8004]=bytes.fromhex('5c008101') # JML $01:8100
+        rom[0x8100]=0x6b
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':'018000',
+                'SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS':'018000:M1X0'}), \
+             patch.object(codegen,'_NAME_RESOLVER',{0x018100:'TailTarget'}), \
+             patch.object(codegen,'_VALID_VARIANTS',{0x018100:{(1,0)}}), \
+             patch.object(codegen,'_VALID_VARIANTS_AUTHORITATIVE',True):
+            source=emit_function(bytes(rom),1,0x8000,1,0)
+        self.assertIn('(cpu_instruction_timing_commit(cpu), TailTarget_M1X0(cpu))',source)
+        self.assertEqual(source.count('cpu->cycles += 4;'),1)
+
+    def test_committed_transfer_cross_bank_c11_compile_and_execution(self):
+        import re, shutil, subprocess, tempfile
+        from v2 import codegen
+        from v2.translation_units import _with_referenced_variant_declarations
+        compiler=os.environ.get('CC') or shutil.which('clang') or shutil.which('gcc')
+        if not compiler:self.skipTest('C11 compiler unavailable')
+        rom=bytearray(0x100000)
+        rom[0x8000:0x8005]=bytes.fromhex('2200810160')
+        rom[0x8100]=0x6b
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':'018000',
+                'SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS':'018000:M1X0'}), \
+             patch.object(codegen,'_NAME_RESOLVER',{0x018100:'TransferTarget'}), \
+             patch.object(codegen,'_VALID_VARIANTS',{0x018100:{(1,0)}}), \
+             patch.object(codegen,'_VALID_VARIANTS_AUTHORITATIVE',True):
+            emitted=emit_function(bytes(rom),1,0x8000,1,0)
+        expression=re.search(r'case 2: _r = (.*?); break;',emitted)[1]
+        header='typedef struct { int master, beam; } CpuState; typedef int RecompReturn;\n'
+        caller=header+'void cpu_instruction_timing_commit(CpuState *cpu);\n'
+        caller+='/* Forward declarations for in-bank entries. */\n'
+        caller+='RecompReturn Caller(CpuState *cpu) { return '+expression+'; }\n'
+        caller=_with_referenced_variant_declarations(caller)
+        target=header+'''#include <assert.h>
+extern RecompReturn Caller(CpuState *cpu);
+void cpu_instruction_timing_commit(CpuState *cpu) { cpu->beam=cpu->master; }
+RecompReturn TransferTarget_M1X0(CpuState *cpu) { assert(cpu->beam==cpu->master); return 17; }
+int main(void) { CpuState cpu={62,0}; assert(Caller(&cpu)==17); return 0; }
+'''
+        with tempfile.TemporaryDirectory() as directory:
+            directory=Path(directory);a=directory/'caller.c';b=directory/'target.c'
+            a.write_text(caller);b.write_text(target);exe=directory/'transfer.exe'
+            result=subprocess.run([compiler,'-std=c11','-Werror=implicit-function-declaration',
+                str(a),str(b),'-o',str(exe)],capture_output=True,text=True)
+            self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+            subprocess.run([str(exe)],check=True,capture_output=True)
+
+    def test_paired_lle_target_transfer_commits_after_frame_and_keeps_call_shape(self):
