+static void GlTimingFinish(void) {
+  if (!g_gl_timings) return;
+  /* Exclusive creation also protects a file created after timing was armed. */
+  FILE *f = fopen(g_gl_timing_path, "wx");
+  if (!f) {
+    fprintf(stderr, "GL timing: cannot create fresh output '%s'\n", g_gl_timing_path);
+  } else {
+    bool failed = fprintf(f, "sequence,width,height,drawable_width,drawable_height,shader,resized_texture,upload_ms,draw_ms,swap_ms,other_ms\n") < 0;
