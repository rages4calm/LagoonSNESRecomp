+"""Explicit seed metadata must preserve mode identity and CLI/cache provenance."""
+import argparse
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+SDK = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(SDK), str(SDK/'recompiler')]
+from v2.program_emit import load_analysis_roots
+from v2.program_analysis import VariantKey
+from tools import sdk_generate
+from tools.v2_emit import _analysis_input_digest, _codegen_environment_digest
+
+
+class AnalysisRootFileTests(unittest.TestCase):
+    def test_exact_variants_comments_bom_and_deduplication(self):
+        with tempfile.TemporaryDirectory() as temp:
+            a=Path(temp)/'roots.txt';b=Path(temp)/'more.txt'
+            a.write_text('\ufeff# Declared seeds, no instruction data\n0084E9:M1X1 # alternate mode\n84e9:m1x0\n',encoding='utf-8')
+            b.write_text('0084E9:M1X1\n018158:M1X0\n')
+            self.assertEqual(load_analysis_roots([a,b]),(
+                VariantKey(0x84e9,1,0),VariantKey(0x84e9,1,1),VariantKey(0x18158,1,0)))
+
+    def test_malformed_line_fails_with_location(self):
+        with tempfile.TemporaryDirectory() as temp:
+            p=Path(temp)/'bad.txt'
+            for bad in ('0084E9','0x0084E9:M1X1','1000000:M1X1','0084E9:M2X1',
+                        '0084E9:M1X9','0084E9:M1X1 trailing','0084E9:M1X1,018158:M1X0'):
+                with self.subTest(bad=bad):
+                    p.write_text('# valid comment\n'+bad+'\n')
+                    with self.assertRaisesRegex(ValueError,r'bad\.txt:2: expected PC24:M0X0'):
+                        load_analysis_roots([p])
+
+    def test_missing_file_fails_instead_of_silently_dropping_seeds(self):
+        with tempfile.TemporaryDirectory() as temp:
+            with self.assertRaises(FileNotFoundError):
+                load_analysis_roots([Path(temp)/'missing.txt'])
+
+    def test_generate_cli_forwards_resolved_root_files(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root=Path(temp);parser=argparse.ArgumentParser();sub=parser.add_subparsers(dest='command')
+            sdk_generate.add_generate_parser(sub)
+            args=parser.parse_args(['generate','--rom','game.sfc','--cfg-dir','cfg','--out-dir','gen',
+                '--project-root',str(root),'--analysis-roots-file','roots.txt',
+                '--analysis-roots-file','more.txt'])
+            with patch.object(sdk_generate,'generate') as generate:
+                self.assertEqual(args.handler(args,Mock()),0)
+                self.assertEqual(generate.call_args.kwargs['analysis_roots_files'],
+                                 [(root/'roots.txt').resolve(),(root/'more.txt').resolve()])
+
+    def test_sdk_forwards_root_file_without_cfg_roots_or_profile(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root=Path(temp);cfg=root/'cfg';cfg.mkdir();(cfg/'bank00.cfg').write_text('bank = 0\n')
+            roots=root/'roots.txt';roots.write_text('0084E9:M1X1\n')
+            identity={'path':str(root/'game.sfc'),'crc32':'00000000','sha256':'0'*64,'size':32768}
+            with patch.object(sdk_generate,'verify_rom',return_value=identity),patch.object(sdk_generate,'run_tool',return_value=0)as run:
+                sdk_generate.generate(rom=root/'game.sfc',cfg_dir=cfg,out_dir=root/'gen',
+                    analysis_roots_files=[roots],progress=Mock(json_progress=False))
+                args=run.call_args.args[1]
+                index=args.index('--analysis-roots-file')
+                self.assertEqual(args[index+1],str(roots.resolve()))
