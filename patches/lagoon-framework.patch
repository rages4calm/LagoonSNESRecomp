+    p+=kRasterStateField; left-=kRasterStateField;
+    if (count>PPU_RASTER_MAX || count>left/5u) return 0;
+    for (uint32_t i=0;i<count;i++,p+=5,left-=5) {
+      uint16_t key=(uint16_t)(p[0]|(uint16_t)p[1]<<8);
+      uint16_t reg=(uint16_t)(p[2]|(uint16_t)p[3]<<8);
