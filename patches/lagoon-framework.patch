+    fprintf(stderr, "GL timing: expected a fresh CSV path\n");
+    return;
+  }
+  g_gl_timings = calloc(kGlTimingCapacity, sizeof(*g_gl_timings));
+  if (!g_gl_timings) {
+    fprintf(stderr, "GL timing: buffer allocation failed\n");
+    return;
+  }
+  if (atexit(GlTimingFinish)) {
+    free(g_gl_timings);
+    g_gl_timings = NULL;
+    fprintf(stderr, "GL timing: could not register output\n");
+    return;
+  }
+  memcpy(g_gl_timing_path, path, strlen(path) + 1);
