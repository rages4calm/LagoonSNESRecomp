diff --git a/tests/runtime_dispatch/wram_read_filter_test.c b/tests/runtime_dispatch/wram_read_filter_test.c
new file mode 100644
index 0000000..30296af
--- /dev/null
+++ b/tests/runtime_dispatch/wram_read_filter_test.c
@@ -0,0 +1,78 @@
+/* Exercise the production bus helpers; reuse only peripheral test stubs. */
+#define main cart_cpu_bus_latch_main
+#include "cart_cpu_bus_latch_test.c"
+#undef main
+uint8 g_ram[0x20000];
+void snes_refresh_charge(void) {}
+void snes_sync_master_clock(Snes *snes, uint64_t clock) { (void)snes; (void)clock; }
+void cart_sync_coprocessors(Cart *cart, uint64_t clock) { (void)cart; (void)clock; }
+static int calls;
+static uint32_t offsets[4];
+static CpuWramReadContext observed;
+static uint8_t filter(uint32_t off, uint8_t value, const CpuWramReadContext *context) {
+    if (calls < 4) offsets[calls] = off;
+    ++calls;
+    observed = *context;
+    return value ^ 0xa5;
+}
+int main(void) {
+    CpuState cpu;
+    static uint8 ram[0x20000];
+    const uint8 banks[] = {0, 0x80, 0x7e, 0x7f};
+    for (unsigned i = 0; i < sizeof(banks); ++i) {
+        reset_cpu(&cpu, ram); g_snes = NULL; calls = 0;
+        unsigned off = banks[i] == 0x7f ? 0x11234 : 0x1234;
+        ram[off] = 0x12; ram[off+1] = 0x34;
+        cpu.S = 0x1fee; cpu.Y = 0x123; cpu.PB = 1;
+        cpu.m_flag = 1; cpu.x_flag = 0; cpu.emulation = 0;
+        cpu_set_wram_read_filter_hook(filter);
+        check_int("active hook", cpu_wram_read_filter_active(), 1);
+        check_int("filtered word", cpu_read16(&cpu,banks[i],0x1234), 0x91b7);
+        check_int("two ordered reads", calls, 2);
+        check_u32("low canonical offset", offsets[0], off);
+        check_u32("high canonical offset", offsets[1], off+1);
+        check_int("filtered high on bus", cpu.open_bus, 0x91);
+        check_int("RAM low untouched",ram[off],0x12);
+        check_int("RAM high untouched",ram[off+1],0x34);
+        check_int("native stack",observed.stack,0x1fee);
+        check_int("native Y",observed.y,0x123);
+        check_int("native bank",observed.pb,1);
+        check_int("native mode",observed.m,1);
+        check_int("native context",observed.interpreter,0);
+        check_u32("no invented native PC",observed.instruction_pc,0xffffffff);
+        cpu_set_wram_read_filter_hook(NULL);
+        check_int("disabled read",cpu_read8(&cpu,banks[i],0x1234),0x12);
+        check_int("disabled hook",cpu_wram_read_filter_active(),0);
+        check_int("no extra calls",calls,2);
+    }
+    cpu_set_wram_read_filter_hook(filter);
+    for (unsigned bank=0x7e; bank<=0x7f; ++bank) {
+        unsigned base=(bank-0x7e)<<16; calls=0;
+        ram[base+0xffff]=0x12; ram[base]=0x34;
+        check_int("same-bank word wrap",cpu_read16(&cpu,bank,0xffff),0x91b7);
+        check_u32("wrapped high offset",offsets[1],base);
+    }
+    calls=0; ram[0x1fff]=0x12;
+    (void)cpu_read16(&cpu,0,0x1fff);
+    check_int("WRAM to IO only filters WRAM",calls,1);
+    (void)cpu_read8(&cpu,0,0x2100);
+    check_int("IO bypasses filter",calls,1);
+    CpuWramReadContext outer={0x01ba52,0x1ffa,0,1,1,0,0,1};
+    CpuWramReadContext inner={0x81ba52,0x1ff8,2,0x81,1,0,0,1};
+    const CpuWramReadContext *old=cpu_swap_wram_read_context(&outer);
+    (void)cpu_read8(&cpu,0,0x1234);
+    check_u32("live interpreter cursor",observed.instruction_pc,0x01ba52);
+    check_int("live interpreter stack",observed.stack,0x1ffa);
+    const CpuWramReadContext *saved=cpu_swap_wram_read_context(&inner);
+    (void)cpu_read8(&cpu,0,0x1234);
+    check_int("nested interpreter Y",observed.y,2);
+    cpu_swap_wram_read_context(saved);
+    (void)cpu_read8(&cpu,0,0x1234);
+    check_int("restored outer Y",observed.y,0);
+    cpu_swap_wram_read_context(old);
+    (void)cpu_read8(&cpu,0,0x1234);
+    check_int("restored native context",observed.interpreter,0);
+    cpu_set_wram_read_filter_hook(NULL);
+    if (!g_failures) puts("WRAM read filter regression passed");
+    return g_failures ? 1 : 0;
+}
diff --git a/tests/runtime_dispatch/wram_write_filter_test.c b/tests/runtime_dispatch/wram_write_filter_test.c
new file mode 100644
index 0000000..28b6a45
--- /dev/null
+++ b/tests/runtime_dispatch/wram_write_filter_test.c
@@ -0,0 +1,128 @@
+/* Reuse the bus test's peripheral stubs, but exercise the actual cpu_state.c
+ * entry points and the real registered hook. No copied write implementation. */
+#define main cart_cpu_bus_latch_main
+#include "cart_cpu_bus_latch_test.c"
+#undef main
+
+/* Clock/coprocessor dependencies of the linked production translation unit.
+ * These tests call unpaced bus writes and do not advance a machine. */
+uint8 g_ram[0x20000];
+void snes_refresh_charge(void) {}
+void snes_sync_master_clock(Snes *snes, uint64_t clock) { (void)snes; (void)clock; }
+void cart_sync_coprocessors(Cart *cart, uint64_t clock) { (void)cart; (void)clock; }
+
+static uint32_t seen_offsets[4];
+static uint8_t seen_inputs[4];
+static uint8_t *test_ram;
+static int seen_count, check_low_visible;
+static unsigned low_offset;
+
+static uint8_t transform(uint32_t off, uint8_t value) {
+    if (seen_count < 4) {
+        seen_offsets[seen_count] = off;
+        seen_inputs[seen_count] = value;
+    }
+    if (check_low_visible && seen_count == 1)
+        check_int("high callback sees committed transformed low byte",
+                  test_ram[low_offset], 0x12 ^ 0xa5);
+    seen_count++;
+    return value ^ 0xa5;
+}
+
+static void start_case(CpuState *cpu, uint8_t *ram) {
+    reset_cpu(cpu, ram);
+    g_snes = NULL;
+    test_ram = ram;
+    seen_count = 0;
+    check_low_visible = 0;
+    memset(seen_offsets, 0xff, sizeof(seen_offsets));
+    memset(seen_inputs, 0, sizeof(seen_inputs));
+    cpu_set_wram_write_filter_hook(transform);
+}
+
+static void exercise_aliases(void) {
+    static const struct { uint8_t bank; unsigned offset; } cases[] = {
+        {0x00, 0x1234}, {0x80, 0x1234}, {0x7e, 0x1234}, {0x7f, 0x11234}
+    };
+    CpuState cpu;
+    uint8_t ram[0x20000];
+    for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        unsigned off = cases[i].offset;
+        start_case(&cpu, ram);
+        cpu_write8(&cpu, cases[i].bank, 0x1234, 0x12);
+        check_int("byte callback once", seen_count, 1);
+        check_u32("byte canonical WRAM offset", seen_offsets[0], off);
+        check_int("byte callback receives original bus byte", seen_inputs[0], 0x12);
+        check_int("byte stores transformed value", ram[off], 0xb7);
+        check_int("byte open bus retains original guest byte", cpu.open_bus, 0x12);
+
+        start_case(&cpu, ram);
+        low_offset = off;
+        check_low_visible = 1;
+        cpu_write16(&cpu, cases[i].bank, 0x1234, 0x3412);
+        check_int("word invokes two byte callbacks", seen_count, 2);
+        check_u32("word low canonical offset", seen_offsets[0], off);
+        check_u32("word high canonical offset", seen_offsets[1], off + 1);
+        check_int("word original low input", seen_inputs[0], 0x12);
+        check_int("word original high input", seen_inputs[1], 0x34);
+        check_int("word transformed low stored", ram[off], 0xb7);
+        check_int("word transformed high stored", ram[off + 1], 0x91);
+        check_int("word open bus retains original guest high", cpu.open_bus, 0x34);
+    }
+}
+
+static void exercise_boundaries(void) {
+    CpuState cpu;
+    uint8_t ram[0x20000];
+    for (unsigned bank = 0x7e; bank <= 0x7f; ++bank) {
+        unsigned base = (bank - 0x7e) << 16;
+        start_case(&cpu, ram);
+        low_offset = base + 0xffff;
+        check_low_visible = 1;
+        cpu_write16(&cpu, (uint8_t)bank, 0xffff, 0x3412);
+        check_int("wrapped word invokes two callbacks", seen_count, 2);
+        check_u32("wrapped word low offset", seen_offsets[0], base + 0xffff);
+        check_u32("wrapped word high stays in same bank", seen_offsets[1], base);
+        check_int("wrapped low stored", ram[base + 0xffff], 0xb7);
+        check_int("wrapped high stored", ram[base], 0x91);
+        check_int("wrapped word original high on open bus", cpu.open_bus, 0x34);
+    }
+    for (unsigned bank = 0; bank <= 0x80; bank += 0x80) {
+        start_case(&cpu, ram);
+        ram[0x2000] = 0x6d;
+        cpu_write16(&cpu, (uint8_t)bank, 0x1fff, 0x3412);
+        check_int("WRAM-to-unmapped only filters low byte", seen_count, 1);
+        check_u32("WRAM edge canonical offset", seen_offsets[0], 0x1fff);
+        check_int("WRAM edge transformed low", ram[0x1fff], 0xb7);
+        check_int("non-WRAM high does not touch flat RAM", ram[0x2000], 0x6d);
+        check_int("boundary open bus original high", cpu.open_bus, 0x34);
+    }
+}
+
+static void exercise_disabled_and_non_wram(void) {
+    CpuState cpu;
+    uint8_t ram[0x20000];
+    start_case(&cpu, ram);
+    cpu_write8(&cpu, 0x00, 0x2100, 0x12);
+    cpu_write16(&cpu, 0x80, 0x8000, 0x3412);
+    check_int("hardware and ROM bypass WRAM filter", seen_count, 0);
+    check_int("unfiltered ROM word bus value", cpu.open_bus, 0x34);
+
+    cpu_set_wram_write_filter_hook(NULL);
+    cpu_write8(&cpu, 0x7e, 0x1234, 0x12);
+    cpu_write16(&cpu, 0x7f, 0x1234, 0x3412);
+    check_int("unregister disables callbacks", seen_count, 0);
+    check_int("unregistered byte unchanged", ram[0x1234], 0x12);
+    check_int("unregistered word low unchanged", ram[0x11234], 0x12);
+    check_int("unregistered word high unchanged", ram[0x11235], 0x34);
+}
+
+int main(void) {
+    exercise_aliases();
+    exercise_boundaries();
+    exercise_disabled_and_non_wram();
+    cpu_set_wram_write_filter_hook(NULL);
+    if (g_failures) return 1;
+    puts("wram_write_filter_test: PASS (canonical aliases, ordered words, wrap, open bus, bypass, unregister)");
+    return 0;
+}
diff --git a/tests/test_jsl_yield_bank.py b/tests/test_jsl_yield_bank.py
new file mode 100644
index 0000000..5c41622
--- /dev/null
+++ b/tests/test_jsl_yield_bank.py
@@ -0,0 +1,59 @@
+"""Execute actual generated JSL code across normal, nonlocal and suspended returns."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'recompiler'))
+
+
+def exercise_jsl_suspension(tmp_path):
+    from v2.emitter_helpers import pb_save_restore_envelope
+    compiler = os.environ.get('CC') or shutil.which('cc')
+    if not compiler:
+        raise unittest.SkipTest('C compiler required')
+    envelope='\n'.join(pb_save_restore_envelope(0x0c,
+        ['RecompReturn _r = callee(cpu, mode);'], trace_pc24=0x01d49e))
+    source='''#include <stdint.h>
+#include <assert.h>
+typedef uint8_t uint8;
+typedef int RecompReturn;
+enum {RECOMP_RETURN_NORMAL=0};
+typedef struct {uint8 PB;} CpuState;
+static int suspended;
+static int interp_bridge_lle_unwind_pending(void) {return suspended;}
+#define cpu_trace_pb_change(...) ((void)0)
+#define cpu_trace_event(...) ((void)0)
+#define cpu_trace_mark_nlr_exit(...) ((void)0)
+static RecompReturn callee(CpuState *cpu,int mode) {
+ assert(cpu->PB==0x0c);
+ if(mode==2){suspended=1;cpu->PB=0;return 0x40000000;}
+ return mode==1?2:0;
+}
+static RecompReturn emitted(CpuState *cpu,int mode) {
+'''+envelope+'''
+ return RECOMP_RETURN_NORMAL;
+}
+int main(void) {
+ CpuState cpu={1};
+ assert(emitted(&cpu,0)==0 && cpu.PB==1);
+ assert(emitted(&cpu,1)==1 && cpu.PB==1);
+ assert(emitted(&cpu,2)==0x3fffffff && cpu.PB==0);
+ return 0;
+}
+'''
+    c=tmp_path/'jsl_suspend.c';c.write_text(source,encoding='utf-8')
+    exe=tmp_path/('jsl_suspend.exe' if os.name=='nt' else 'jsl_suspend')
+    subprocess.run([compiler,'-std=c11','-Wall','-Wextra','-Werror',str(c),'-o',str(exe)],check=True,capture_output=True)
+    subprocess.run([str(exe)],check=True,capture_output=True)
+
+
+class JslYieldBankChecks(unittest.TestCase):
+    def test_generated_jsl_return_and_suspension_banks(self):
+        with tempfile.TemporaryDirectory() as directory:
+            exercise_jsl_suspension(Path(directory))
+
+
+if __name__=='__main__':unittest.main()
diff --git a/tests/test_precise_root_timing.py b/tests/test_precise_root_timing.py
new file mode 100644
index 0000000..22c06b3
--- /dev/null
+++ b/tests/test_precise_root_timing.py
@@ -0,0 +1,232 @@
+"""Regression for opt-in native roots sharing interpreter instruction boundaries."""
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'recompiler'))
+from v2.emit_function import emit_function, _precise_root_enabled
+
+
+class PreciseTimingChecks(unittest.TestCase):
+    def emit(self,roots,m=0,x=0):
+        rom=bytearray(0x100000)
+        # LDA abs,X; CLC; ADC abs,X; STA abs,X; RTS. Native M0/X0.
+        rom[0x8000:0x800b]=bytes.fromhex('bd0205187d06059d020560')
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':roots}):
+            return emit_function(bytes(rom),1,0x8000,m,x)
+
+    def test_exact_variant_preserves_nonmatching_historical_coarse_body(self):
+        coarse=self.emit('')
+        self.assertEqual(self.emit('018000:M1X1'),coarse)
+        self.assertEqual(self.emit('018000:M0X0'),self.emit('018000'))
+        self.assertEqual(self.emit('018000:M1X1',1,1),self.emit('018000',1,1))
+        self.assertEqual(self.emit('018000:M1X0',1,1),self.emit('',1,1))
+
+    def test_mixed_tokens_and_legacy_hex_syntax(self):
+        for tokens in ('018000,028000', '0x018000\n028000:M1X1',
+                       '028000:M1X0, 018000:M0X0', '018000:m0x0'):
+            self.assertEqual(self.emit(tokens),self.emit('018000'))
+        for m in (0,1):
+            for x in (0,1):
+                self.assertTrue(_precise_root_enabled('018000',0x018000,m,x))
+                self.assertEqual(self.emit('018000',m,x),self.emit('0x018000,028000',m,x))
+
+    def test_invalid_variant_fails_closed_even_after_matching_token(self):
+        for token in ('018000:M2X0','018000:M0X2','018000:M0',
+                      '018000:M00X0','018000:M0X0:extra','1000000:M0X0',
+                      '-1:M0X0',':M0X0','018000:','018000:foo'):
+            with self.subTest(token=token),self.assertRaises(ValueError):
+                self.emit('018000,'+token)
+
+    def test_precise_root_yields_at_every_instruction(self):
+        source=self.emit('018000')
+        self.assertEqual(source.count('cpu_trace_block(cpu,'),5)
+        self.assertIn('cpu_read16_timed(cpu,',source)
+        self.assertIn('cpu_write16_timed(cpu,',source)
+        # Fetch/internal baseline: LDA abs,X M0X0 = 6 cycles, 3 fetch bytes.
+        self.assertIn('cpu->master_cycles += 36 + 3 * (',source)
+        # ABI return-address inspection is host bookkeeping, not guest traffic.
+        prologue=source.split('cpu_trace_block(cpu,')[0]
+        self.assertIn('cpu_read8(cpu,',prologue)
+        self.assertNotIn('cpu_read8_timed(cpu,',prologue)
+
+    def test_other_roots_retain_existing_model(self):
+        for roots in ('','028000'):
