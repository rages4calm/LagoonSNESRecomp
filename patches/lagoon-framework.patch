+  if (!ppu_raster_state_valid(data,size)) return 0;
+  s_raster_cur=p[12]; s_raster_armed=p[13]; s_raster_have_completed=p[14];
+  p+=kRasterStateHeader;
+  memset(s_field,0,sizeof(s_field));
+  for (unsigned n=0;n<2;n++) {
+    PpuRasterField *f=&s_field[n];
+    memcpy(f->regs,p,PPU_SAVESTATE_REGS_SIZE); p+=PPU_SAVESTATE_REGS_SIZE;
+    f->scrollPrev=*p++; f->scrollPrev2=*p++; f->m7prev=*p++; f->hdmaen=*p++;
