+      const GlTiming *t = g_gl_timings + i;
+      failed = fprintf(f, "%u,%d,%d,%d,%d,%d,%d,%.6f,%.6f,%.6f,%.6f\n",
+          t->sequence, t->width, t->height, t->drawable_width,
+          t->drawable_height, t->shader, t->resized, t->upload * 1000,
+          t->draw * 1000, t->swap * 1000, t->other * 1000) < 0;
+    }
+    if (fclose(f)) failed = true;
+    if (failed) fprintf(stderr, "GL timing: output write failed\n");
+  }
+  if (g_gl_timing_dropped)
+    fprintf(stderr, "GL timing: capacity reached, %llu later presents omitted\n", g_gl_timing_dropped);
+  free(g_gl_timings);
+  g_gl_timings = NULL;
+}
