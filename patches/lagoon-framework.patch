+ def test_generation_identity_modes_and_no_hle(self):
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td);rom=bytearray([255]*32768);rom[:2]=bytes([0xea,0x60]);rom[0x7ffc:0x7ffe]=bytes([0,128]);(p/'rom.sfc').write_bytes(rom)
+   cfg=p/'cfg';cfg.mkdir();cf=cfg/'bank00.cfg'
+   base='bank = 00\nfunc Guarded 8000 end:8002 entry_mx:1,0\n'
+   def generate(name,directive='',extra=()):
