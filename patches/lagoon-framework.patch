+                'SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS':'018000:M1X0'}), \
+             patch.object(codegen,'_NAME_RESOLVER',{0x018100:'UnavailableTarget'}), \
+             patch.object(codegen,'_VALID_VARIANTS',{}), \
+             patch.object(codegen,'_VALID_VARIANTS_AUTHORITATIVE',True):
+            source=emit_function(bytes(rom),1,0x8000,1,0)
+        call='(cpu_instruction_timing_commit(cpu), interp_tier_run_call_frame(cpu,'
+        self.assertIn(call,source)
+        self.assertLess(source.index('cpu_write8_timed(cpu, 0x00, cpu->S'),source.index(call))
+        self.assertLess(source.index('cpu->host_return_valid = 3;'),source.index(call))
+        self.assertNotIn('UnavailableTarget_M1X0(cpu)',source)
+        import re, shutil, subprocess, tempfile
+        compiler=os.environ.get('CC') or shutil.which('clang') or shutil.which('gcc')
+        if compiler:
+            expression=re.search(r'case 2: _r = (.*?); break;',source)[1]
+            header='''#include <stddef.h>
+typedef unsigned uint32; typedef unsigned char uint8;
+typedef struct { unsigned PB; int master, beam; } CpuState;
+typedef int RecompReturn;
+'''
+            caller=header+'''void cpu_instruction_timing_commit(CpuState *cpu);
+RecompReturn interp_tier_run_call_frame(CpuState *, uint32, uint32, uint8, void *);
+'''+ 'RecompReturn Caller(CpuState *cpu) { return '+expression+'; }\n'
+            target=header+'''#include <assert.h>
+extern RecompReturn Caller(CpuState *cpu);
+void cpu_instruction_timing_commit(CpuState *cpu) { cpu->beam=cpu->master; }
+RecompReturn interp_tier_run_call_frame(CpuState *cpu, uint32 target,
+    uint32 source, uint8 frame, void *result) {
+  assert(cpu->beam==cpu->master && target==0x18100 && source==0x18000);
+  assert(frame==3 && result==NULL); return 17;
+}
+int main(void) { CpuState cpu={1,62,0}; assert(Caller(&cpu)==17); return 0; }
+'''
+            with tempfile.TemporaryDirectory() as directory:
+                directory=Path(directory);a=directory/'caller.c';b=directory/'helper.c'
+                a.write_text(caller);b.write_text(target);exe=directory/'transfer.exe'
+                result=subprocess.run([compiler,'-std=c11','-Werror=implicit-function-declaration',
+                    str(a),str(b),'-o',str(exe)],capture_output=True,text=True)
+                self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+                subprocess.run([str(exe)],check=True,capture_output=True)
+
+
+    def test_paired_lle_commit_handles_nested_arguments(self):
+        from v2.emit_function import _commit_paired_interpreter_calls
+        call='interp_tier_run_call_frame(cpu, ((unsigned)cpu->PB << 16) | (0x8100u), 0x8000u, 3, NULL)'
+        before='case 2: _r = '+call+'; break;'
+        self.assertEqual(_commit_paired_interpreter_calls(before),
+            'case 2: _r = (cpu_instruction_timing_commit(cpu), '+call+'); break;')
+        self.assertEqual(_commit_paired_interpreter_calls('cpu_read8(cpu, 0, 1);'),
+                         'cpu_read8(cpu, 0, 1);')
+
+
+if __name__=='__main__':unittest.main()
