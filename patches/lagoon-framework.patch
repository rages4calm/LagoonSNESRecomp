diff --git a/tests/test_precise_root_timing.py b/tests/test_precise_root_timing.py
new file mode 100644
index 0000000..9ea9e72
--- /dev/null
+++ b/tests/test_precise_root_timing.py
@@ -0,0 +1,39 @@
+"""Regression for opt-in native roots sharing interpreter instruction boundaries."""
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'recompiler'))
+from v2.emit_function import emit_function
+
+
+class PreciseTimingChecks(unittest.TestCase):
+    def emit(self,roots):
+        rom=bytearray(0x100000)
+        # LDA abs,X; CLC; ADC abs,X; STA abs,X; RTS. Native M0/X0.
+        rom[0x8000:0x800b]=bytes.fromhex('bd0205187d06059d020560')
+        with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':roots}):
+            return emit_function(bytes(rom),1,0x8000,0,0)
+
+    def test_precise_root_yields_at_every_instruction(self):
+        source=self.emit('018000')
+        self.assertEqual(source.count('cpu_trace_block(cpu,'),5)
+        self.assertIn('cpu_read16_timed(cpu,',source)
+        self.assertIn('cpu_write16_timed(cpu,',source)
+        # Fetch/internal baseline: LDA abs,X M0X0 = 6 cycles, 3 fetch bytes.
+        self.assertIn('cpu->master_cycles += 36 + 3 * (',source)
+        # ABI return-address inspection is host bookkeeping, not guest traffic.
+        prologue=source.split('cpu_trace_block(cpu,')[0]
+        self.assertIn('cpu_read8(cpu,',prologue)
+        self.assertNotIn('cpu_read8_timed(cpu,',prologue)
+
+    def test_other_roots_retain_existing_model(self):
+        for roots in ('','028000'):
+            source=self.emit(roots)
+            self.assertEqual(source.count('cpu_trace_block(cpu,'),1)
+            self.assertNotIn('_timed(cpu,',source)
+
+
+if __name__=='__main__':unittest.main()
