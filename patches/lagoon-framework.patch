+def _commit_paired_interpreter_calls(line: str) -> str:
+    """Sequence completed native JSR/JSL timing before paired LLE targets.
+
+    Keep the helper(cpu, ...) call itself intact for textual ABI consumers.
+    Arguments can contain nested expressions, so find the matching close rather
+    than truncating a call at its first parenthesis.
+    """
+    pattern = re.compile(r'\b(?:interp_tier_run_call_frame|interp_tier_run_call)\(cpu,')
+    calls = []
+    for match in pattern.finditer(line):
+        opening = line.index('(', match.start())
+        depth, cursor, quote = 1, opening + 1, None
+        while cursor < len(line) and depth:
+            char = line[cursor]
+            if quote:
+                if char == '\\':
+                    cursor += 2
+                    continue
+                if char == quote:
+                    quote = None
+            elif char in ('"', "'"):
+                quote = char
+            elif char == '(':
+                depth += 1
+            elif char == ')':
+                depth -= 1
+            cursor += 1
+        if depth:
+            raise ValueError('Unbalanced generated paired interpreter call')
+        calls.append((match.start(), cursor))
+    for start, end in reversed(calls):
+        line = (line[:start] + '(cpu_instruction_timing_commit(cpu), '
+                + line[start:end] + ')' + line[end:])
+    return line
+
