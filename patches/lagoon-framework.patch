+/* Optional bounded device-queue evidence. CPU beam stamps on a deferred
+ * audio_trace APPLY describe when catch-up ran, not the SPC application
+ * cycle. Capture both the scheduled target and actual device cycle here.
+ * Buffer until exit so diagnostic I/O cannot change catch-up cadence. */
+typedef struct ApuQueueTraceEvent {
+  uint64_t guest, target, clock;
+  uint8_t kind, port, value;
+} ApuQueueTraceEvent;
+/* A full music-bank plus sample upload exceeds 65536 diagnostic events.
+ * Allocate this bounded buffer only when the read-only trace is requested. */
+enum { APU_QUEUE_TRACE_CAPACITY = 131072 };
+static ApuQueueTraceEvent *apu_queue_trace_events;
+static size_t apu_queue_trace_count;
+static unsigned apu_queue_trace_overflow;
+static int apu_queue_trace_enabled = -1;
+static const char *apu_queue_trace_path;
+
+static void apu_queue_trace_finish(void) {
+  if (!apu_queue_trace_events) return;
+  FILE *file = fopen(apu_queue_trace_path, "wb");
+  if (file) {
+    fputs("event,port,value,guest_cycle,target_cycle,port_clock\n", file);
+    for (size_t i = 0; i < apu_queue_trace_count; ++i) {
+      const ApuQueueTraceEvent *event = apu_queue_trace_events + i;
+      fprintf(file, "%c,%u,%u,%llu,%llu,%llu\n", event->kind,
+          event->port, event->value, (unsigned long long)event->guest,
+          (unsigned long long)event->target, (unsigned long long)event->clock);
+    }
+    fprintf(file, "END,%llu,%u\n", (unsigned long long)apu_queue_trace_count,
+        apu_queue_trace_overflow);
+    fclose(file);
+  }
+  free(apu_queue_trace_events);
+  apu_queue_trace_events = NULL;
+}
+
+static void apu_queue_trace(const Apu *apu, uint8_t kind, uint8_t port,
+                          uint8_t value, uint64_t guest, uint64_t target) {
+  if (apu_queue_trace_enabled < 0) {
+    apu_queue_trace_path = getenv("SNESRECOMP_APU_QUEUE_TRACE");
+    apu_queue_trace_enabled = apu_queue_trace_path && *apu_queue_trace_path;
+    if (apu_queue_trace_enabled) {
+      apu_queue_trace_events = calloc(APU_QUEUE_TRACE_CAPACITY,
+                                      sizeof(*apu_queue_trace_events));
+      if (!apu_queue_trace_events) { apu_queue_trace_enabled = 0; return; }
+      atexit(apu_queue_trace_finish);
+    }
+  }
+  if (!apu_queue_trace_enabled) return;
+  if (apu_queue_trace_count == APU_QUEUE_TRACE_CAPACITY) {
+    if (apu_queue_trace_overflow != UINT_MAX) ++apu_queue_trace_overflow;
+    return;
+  }
+  apu_queue_trace_events[apu_queue_trace_count++] = (ApuQueueTraceEvent){
+      guest, target, apu->portClock, kind, port, value};
+}
+
