+                self.assertNotIn('--profile-manifest',args)
+
+    def test_transfer_timing_selector_invalidates_body_cache(self):
+        with patch.dict(os.environ,{},clear=True):
+            control=_codegen_environment_digest('same-source')
+            os.environ['SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS']='018158:M1X0'
+            native=_codegen_environment_digest('same-source')
+            os.environ['SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS']='018158:M1X1'
+            self.assertNotEqual(_codegen_environment_digest('same-source'),native)
+            self.assertNotEqual(control,native)
+            del os.environ['SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS']
+            self.assertEqual(_codegen_environment_digest('same-source'),control)
+
+    def test_recipe_digest_preserves_all_environment_cache_selectors(self):
+        with patch.dict(os.environ, {}, clear=True):
+            baseline = _codegen_environment_digest('same-source')
+            recipe = _codegen_environment_digest('same-source', 'a' * 64)
+            self.assertNotEqual(recipe, baseline)
+            self.assertEqual(recipe, _codegen_environment_digest('same-source', 'A' * 64))
+            for name in ('SNESRECOMP_EMIT_AOT_DENY_GATE', 'SNESRECOMP_PRECISE_AOT_ROOTS',
+                         'SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS'):
+                with self.subTest(selector=name), patch.dict(os.environ, {name: '018158:M1X0'}):
+                    self.assertNotEqual(recipe, _codegen_environment_digest('same-source', 'a' * 64))
+            with self.assertRaisesRegex(ValueError, 'must be a SHA-256'):
+                _codegen_environment_digest('same-source', 'invalid')
+
+    def test_generate_cli_preserves_historical_profiles_with_analysis_roots(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            parser = argparse.ArgumentParser()
+            sdk_generate.add_generate_parser(parser.add_subparsers(dest='command'))
+            args = parser.parse_args(['generate', '--rom', 'game.sfc', '--cfg-dir', 'cfg',
+                '--out-dir', 'gen', '--project-root', str(root),
+                '--analysis-roots-file', 'roots.txt', '--historical-profile-manifest', 'old.json'])
+            with patch.object(sdk_generate, 'generate') as generate:
+                self.assertEqual(args.handler(args, Mock()), 0)
+                self.assertEqual(generate.call_args.kwargs['historical_profile_manifests'],
+                                 [(root / 'old.json').resolve()])
+                self.assertEqual(generate.call_args.kwargs['analysis_roots_files'],
+                                 [(root / 'roots.txt').resolve()])
+
+    def test_seed_content_participates_in_analysis_cache_identity(self):
+        kwargs=dict(rom=b'rom',generator_digest='g',config_digest='c',force_lle=(),cfg_roots=False,
