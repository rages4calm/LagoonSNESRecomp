+    def test_opt_in_native_transfer_commits_after_jsl_frame(self):
+        from v2 import codegen
+        rom=bytearray(0x100000)
+        rom[0x8000:0x8005]=bytes.fromhex('2200810160') # JSL $01:8100; RTS
+        rom[0x8100]=0x6b
+        def emit(transfers,precise='018000'):
+            with patch.dict(os.environ,{'SNESRECOMP_PRECISE_AOT_ROOTS':precise,
+                    'SNESRECOMP_PRECISE_AOT_TRANSFER_ROOTS':transfers}), \
+                 patch.object(codegen,'_NAME_RESOLVER',{0x018100:'TransferTarget'}), \
+                 patch.object(codegen,'_VALID_VARIANTS',{0x018100:{(1,0)}}), \
+                 patch.object(codegen,'_VALID_VARIANTS_AUTHORITATIVE',True):
+                return emit_function(bytes(rom),1,0x8000,1,0)
+        legacy=emit('')
+        self.assertEqual(emit('028000:M1X0'),legacy)
+        opted=emit('018000:M1X0')
+        call='(cpu_instruction_timing_commit(cpu), TransferTarget_M1X0(cpu))'
+        self.assertIn(call,opted)
+        from v2.translation_units import _with_referenced_variant_declarations
+        from v2.link_closure import _CALL_RE
+        declared=_with_referenced_variant_declarations(
+            '/* Forward declarations for in-bank entries. */\n'+opted)
+        self.assertIn('RecompReturn TransferTarget_M1X0(CpuState *cpu);',declared)
+        self.assertIn('TransferTarget_M1X0',_CALL_RE.findall(opted))
+        self.assertLess(opted.index('cpu_write8_timed(cpu, 0x00, cpu->S'),opted.index(call))
+        self.assertLess(opted.index('cpu->host_return_valid = 3;'),opted.index(call))
+        self.assertIn('TransferTarget_M1X0(cpu)',legacy)
+        self.assertNotIn(call,emit('018000:M1X0',precise=''))
