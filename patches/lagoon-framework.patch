@@ -0,0 +1,60 @@
+"""Execute generated stack-programmed calls with a preserved continuation."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+from _helpers import make_lorom_bank0
+from test_callee_stack_cleanup import _RUNTIME
+from v2.emit_function import emit_function
+
+
+@pytest.mark.parametrize("far", [False, True])
+def test_direct_bounce_preserves_synthetic_call_continuation(tmp_path, far):
+    mingw = Path("C:/msys64/mingw64/bin/gcc.exe")
+    compiler = os.environ.get("CC") or (str(mingw) if mingw.is_file() else shutil.which("cc"))
+    if not compiler:
+        pytest.skip("C compiler required")
+    # Long: PHK/PEA creates a continuation, PHX/PHX/PLB/PHA builds
+    # the far target. Short: two PEAs create continuation and target.
+    body = (bytes.fromhex("4bf47f80dadaaba9009048e2206b") if far else
+            bytes.fromhex("f47f80f4009060"))
+    generated = emit_function(make_lorom_bank0({0x8000: body}), 0, 0x8000,
+                              0, 1, end=0x8000 + len(body), func_name="ComputedCall")
+    runtime = _RUNTIME.split("static int check(", 1)[0]
+    runtime = runtime.replace("int interp_bridge_has_direct_paired_bounce(void) { return 0; }",
+                              "int interp_bridge_has_direct_paired_bounce(void) { return 1; }")
+    runtime = runtime.replace("GENERATED", generated)
+    runtime += r'''
+int main(void) {
+  const uint16 entries[] = {0x01fd, 0x0001};
+  for (unsigned i = 0; i < 2; ++i) {
+    CpuState cpu = {0};
+    memset(g_ram, 0, sizeof g_ram);
+    cpu.ram = g_ram; cpu.S = entries[i]; cpu.X = 1;
+    cpu.host_return_valid = 2; cpu.x_flag = 1; cpu.P = 0x10;
+    cpu_write16(&cpu, 0, (uint16)(cpu.S + 1), 0x8123);
+    other_exits = 0; ancestor_skip = -1;
+    ComputedCall_M0X1(&cpu);
+    if (other_exits != 1 || other_target != TARGET ||
+        cpu.S != (uint16)(entries[i] - LOCALS) || g_recomp_stack_top != 0)
+      return 1;
+    if (cpu_read16(&cpu, 0, (uint16)(cpu.S + 1)) != 0x807f)
+      return 2; /* continuation must still be on the guest stack */
+    if (cpu_read16(&cpu, 0, (uint16)(entries[i] + 1)) != 0x8123)
+      return 3; /* original interpreted caller is still above the continuation */
+  }
+  return 0;
+}
+'''.replace("TARGET", "0x019001" if far else "0x009001").replace("LOCALS", "3" if far else "2")
+    source = tmp_path / "computed_call.c"
+    source.write_text(runtime)
+    exe = tmp_path / ("computed_call.exe" if os.name == "nt" else "computed_call")
+    repo = Path(__file__).resolve().parents[2]
+    build = subprocess.run([compiler, "-std=c11", "-O1", "-I", str(repo / "runner/src"),
+                            str(source), "-o", str(exe)], capture_output=True, text=True)
+    assert build.returncode == 0, build.stderr
+    result = subprocess.run([str(exe)], capture_output=True, text=True)
+    assert result.returncode == 0, result.stdout + result.stderr
diff --git a/tests/v2/test_entry_hook.py b/tests/v2/test_entry_hook.py
new file mode 100644
index 0000000000000000000000000000000000000000..76de9b8d4e8e5f0d676ff324091cc6f129838a60
--- /dev/null
+++ b/tests/v2/test_entry_hook.py
@@ -0,0 +1,320 @@
+"""`entry_hook`: an observational host callback before a compiled instruction.
+
+Contract (docs/ENTRY_HOOK.md): the callback runs once per execution of the
+hooked instruction by compiled code, after the block's deadline check and
+before anything of that instruction runs or is charged. An execution the
+compiled code hands to the interpreter is not reported by compiled code; the
+interpreter executes the instruction and its own pre-opcode hook sees it.
+"""
+import os
+import pathlib
+import subprocess
+import tempfile
+
+import pytest
+
+from v2.cfg_loader import load_bank_cfg  # noqa: E402
+from v2.emit_function import emit_function  # noqa: E402
+
+_REPO = pathlib.Path(__file__).resolve().parents[2]
+
+
+def _load(text):
+    fd, path = tempfile.mkstemp(suffix='.cfg', text=True)
+    with os.fdopen(fd, 'w', encoding='utf-8') as f:
+        f.write(text)
+    try:
+        return load_bank_cfg(path)
+    finally:
+        os.unlink(path)
+
+
+def test_entry_hook_parses():
+    cfg = _load("bank = 00\nentry_hook 9437 HostSawList\n")
+    assert cfg.entry_hook == {0x9437: 'HostSawList'}
+
+
+@pytest.mark.parametrize('text, why', [
+    ("bank = 00\nentry_hook 9437\n", 'needs <pc16> <c_function>'),
+    ("bank = 00\nentry_hook 9437 9Bad\n", 'valid C identifier'),
+    ("bank = 00\nentry_hook 9437 A\nentry_hook 9437 B\n", 'duplicate'),
+    ("bank = 00\nhle_func 9437 HleList\nentry_hook 9437 A\n",
+     'replaced by hle_func'),
+])
+def test_entry_hook_parse_errors(text, why):
+    with pytest.raises(ValueError, match=why):
+        _load(text)
+
+
+# Count  $8000: INC $40 / LDA $40 / AND #$03 / BNE $8000 / RTS
+#               (the hooked entry is also the loop head)
+# Rec    $8100: LDA $41 / BEQ + / DEC $41 / JSR $8100 / + RTS
+# Twice  $8200: JSR $8000 / JSR $8000 / RTS
+# Fall   $8300: LDA #$05 / STA $42 / [$8304, hooked] INC $42 / RTS
+_CODE = {
+    0x8000: 'E6 40 A5 40 29 03 D0 F8 60',
+    0x8100: 'A5 41 F0 05 C6 41 20 00 81 60',
+    0x8200: '20 00 80 20 00 80 60',
+    0x8300: 'A9 05 85 42 E6 42 60',
+}
+_FUNCS = [  # (start, end, name)
+    (0x8000, 0x8009, 'bank_00_8000'),
+    (0x8100, 0x810A, 'bank_00_8100'),
+    (0x8200, 0x8207, 'Twice'),
+    (0x8300, 0x8307, 'Fall'),
+]
+_HOOKS = {0x008000: 'HostSaw', 0x008100: 'HostSaw', 0x008304: 'HostSaw'}
+
+
+def _rom() -> bytes:
+    rom = bytearray(0x8000)
+    for pc, code in _CODE.items():
+        data = bytes.fromhex(code)
+        rom[pc - 0x8000:pc - 0x8000 + len(data)] = data
+    return bytes(rom)
+
+
+def _emit(name):
+    start, end, func = next(f for f in _FUNCS if f[2] == name)
+    return emit_function(_rom(), bank=0, start=start, entry_m=1, entry_x=1,
+                         end=end, func_name=func, entry_hooks=_HOOKS)
+
+
+def test_hook_is_observational_and_sits_between_deadline_and_charge():
+    src = _emit('bank_00_8000')
+    assert 'extern void HostSaw(const CpuState *cpu, uint32 pc24);' in src
+    call = 'HostSaw(cpu, 0x008000u);'
+    assert src.count(call) == 1          # one block, reached by every entry
+    entry = src.index('  L_8000_M1X1:')
+    # A yield at the block hands this execution to the interpreter, whose own
+    # hook reports it; the compiled call must come after that exit ...
+    assert src.index('interp_bridge_lle_yield_unwind', entry) < src.index(call)
+    # ... and before anything of the instruction is charged or run.
+    assert src.index(call) < src.index('cpu->cycles +=', entry)
+    assert src.index(call) < src.index('cpu_write8', entry)
+
+
+def test_a_fall_through_into_the_hooked_pc_starts_a_hooked_block():
+    src = _emit('Fall')
+    label = src.index('  L_8304_M1X1:')
+    call = src.index('HostSaw(cpu, 0x008304u);')
+    assert src.index('interp_bridge_lle_yield_unwind', label) < call
+    assert call < src.index('cpu->cycles +=', label)
+
+
+def test_no_hook_no_code():
+    rom = bytes([0x60]) + bytes(0x7FFF)
+    src = emit_function(rom, bank=0, start=0x8000, entry_m=1, entry_x=1,
+                        end=0x8001, func_name='Plain',
+                        entry_hooks={0x009000: 'Elsewhere'})
+    assert 'Elsewhere' not in src
+
+
+_PRELUDE = r'''
+RecompReturn bank_00_8000_M0X0(CpuState *cpu);
+RecompReturn bank_00_8000_M0X1(CpuState *cpu);
+RecompReturn bank_00_8000_M1X0(CpuState *cpu);
+RecompReturn bank_00_8100_M0X0(CpuState *cpu);
+RecompReturn bank_00_8100_M0X1(CpuState *cpu);
+RecompReturn bank_00_8100_M1X0(CpuState *cpu);
+
+/* The host's observer: records what it saw, changes nothing. */
+enum { kMaxHooks = 32 };
+static int g_hooks;
+static uint32 g_hook_pc[kMaxHooks];
+static uint16 g_hook_a[kMaxHooks], g_hook_s[kMaxHooks];
+static uint8 g_hook_counter[kMaxHooks];
+void HostSaw(const CpuState *cpu, uint32 pc24) {
+  if (g_hooks < kMaxHooks) {
+    g_hook_pc[g_hooks] = pc24;
+    g_hook_a[g_hooks] = cpu->A;
+    g_hook_s[g_hooks] = cpu->S;
+    g_hook_counter[g_hooks] = cpu->ram[pc24 == 0x008000u ? 0x40 :
+                                       pc24 == 0x008100u ? 0x41 : 0x42];
+  }
+  g_hooks++;
+}
+'''
+
+_MAIN = r'''
+static int fails;
+static const char *scenario;
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "%s:%d %s FAILED: %s\n", \
+    __FILE__, __LINE__, scenario, #c); fails++; } } while (0)
+
+static RecompReturn wrong_width(CpuState *cpu) {
+  (void)cpu; fails++; fprintf(stderr, "%s: wrong-width variant\n", scenario);
+  return RECOMP_RETURN_NORMAL;
+}
+RecompReturn bank_00_8000_M0X0(CpuState *cpu) { return wrong_width(cpu); }
+RecompReturn bank_00_8000_M0X1(CpuState *cpu) { return wrong_width(cpu); }
+RecompReturn bank_00_8000_M1X0(CpuState *cpu) { return wrong_width(cpu); }
+RecompReturn bank_00_8100_M0X0(CpuState *cpu) { return wrong_width(cpu); }
+RecompReturn bank_00_8100_M0X1(CpuState *cpu) { return wrong_width(cpu); }
+RecompReturn bank_00_8100_M1X0(CpuState *cpu) { return wrong_width(cpu); }
+
+static void prepare(CpuState *cpu, int deadline_at) {
+  memset(cpu, 0, sizeof *cpu);
+  memset(g_ram, 0, sizeof g_ram);
+  cpu->ram = g_ram;
+  cpu->S = 0x01FF; cpu->m_flag = 1; cpu->x_flag = 1; cpu->P = 0x30;
+  cpu->A = 0x77;
+  g_tc_valid = 0; g_recomp_stack_top = 0;
+  g_other_exits = 0; g_other_target = 0;
+  g_hooks = 0; g_deadline_n = 0; g_deadline_at = deadline_at;
+  cpu_push_jsr_return_frame(cpu);       /* host calls the routine like a JSR */
+}
+
+int main(void) {
+  CpuState cpu;
+
+  scenario = "loop back to the hooked entry";
+  prepare(&cpu, 0);
+  bank_00_8000_M1X1(&cpu);
+  CHECK(g_hooks == 4);                  /* $8000 executed four times */
+  for (int i = 0; i < 4; i++) {
+    CHECK(g_hook_pc[i] == 0x008000u);
+    CHECK(g_hook_counter[i] == i);      /* before the INC of that pass */
+    CHECK(g_hook_s[i] == 0x01FD);
+  }
+  CHECK(g_hook_a[0] == 0x77);           /* the caller's A */
+  CHECK(g_hook_a[1] == 1 && g_hook_a[2] == 2 && g_hook_a[3] == 3);
+  CHECK(g_ram[0x40] == 4);
+  CHECK(g_other_exits == 0);
+
+  scenario = "deadline in the prologue";
+  prepare(&cpu, 1);
+  bank_00_8000_M1X1(&cpu);
+  CHECK(g_hooks == 0);                  /* nothing executed compiled */
+  CHECK(g_other_exits == 1 && g_other_target == 0x008000u);
+  CHECK(g_ram[0x40] == 0);
+
+  scenario = "deadline at the hooked block";
+  prepare(&cpu, 2);
+  bank_00_8000_M1X1(&cpu);
+  CHECK(g_hooks == 0);
+  CHECK(g_other_exits == 1 && g_other_target == 0x008000u);
+  CHECK(g_ram[0x40] == 0);
+
+  scenario = "deadline on the back-edge to the hooked block";
+  prepare(&cpu, 3);
+  bank_00_8000_M1X1(&cpu);
+  CHECK(g_hooks == 1);                  /* the one execution done compiled */
+  CHECK(g_ram[0x40] == 1);
+  CHECK(g_other_exits == 1 && g_other_target == 0x008000u);
+
+  scenario = "two calls";
+  prepare(&cpu, 0);
+  Twice_M1X1(&cpu);
+  CHECK(g_hooks == 8);
+  for (int i = 0; i < 8 && i < kMaxHooks; i++) {
+    CHECK(g_hook_pc[i] == 0x008000u);
+    CHECK(g_hook_s[i] == 0x01FB);       /* host frame + JSR frame */
+  }
+  CHECK(g_ram[0x40] == 8);
+  CHECK(g_other_exits == 0);
+
+  scenario = "recursion";
+  prepare(&cpu, 0);
+  g_ram[0x41] = 2;
+  bank_00_8100_M1X1(&cpu);
+  CHECK(g_hooks == 3);
+  CHECK(g_hook_s[0] == 0x01FD && g_hook_s[1] == 0x01FB && g_hook_s[2] == 0x01F9);
+  CHECK(g_hook_counter[0] == 2 && g_hook_counter[1] == 1 &&
+        g_hook_counter[2] == 0);
+  CHECK(g_ram[0x41] == 0);
+  CHECK(g_other_exits == 0);
+  CHECK(cpu.S == 0x01FF);
+
+  scenario = "fall-through into a hooked instruction";
+  prepare(&cpu, 0);
+  Fall_M1X1(&cpu);
+  CHECK(g_hooks == 1);
+  CHECK(g_hook_pc[0] == 0x008304u);
+  CHECK(g_hook_counter[0] == 5);        /* STA done, INC not yet */
+  CHECK(g_hook_a[0] == 5);
+  CHECK(g_ram[0x42] == 6);
+  CHECK(g_other_exits == 0);
+
+  if (fails) return 1;
+  puts("ok");
+  return 0;
+}
+'''
+
+
+def test_compiled_hook_reports_each_execution_exactly_once(tmp_path):
+    import test_hle_func_seam as seam
+    compiler = seam._compiler()
+    if not compiler:
+        pytest.skip('C compiler required')
+    harness = seam._HARNESS.split('/* The C helpers.')[0]
+    deadline = ('int interp_bridge_lle_master_deadline_reached(const CpuState *cpu) {\n'
+                '  (void)cpu; return 0;\n}')
+    assert deadline in harness
+    harness = harness.replace(deadline, (
+        '/* Scripted deadline: the Nth check of the run reports expiry. */\n'
+        'static int g_deadline_n, g_deadline_at;\n'
+        'int interp_bridge_lle_master_deadline_reached(const CpuState *cpu) {\n'
+        '  (void)cpu; return ++g_deadline_n == g_deadline_at;\n}'))
+    generated = ''.join(_emit(name) for _, _, name in _FUNCS)
+    source = harness + _PRELUDE + generated + _MAIN
+    c_file = tmp_path / 'entry_hook.c'
+    c_file.write_text(source, encoding='utf-8')
+    exe = tmp_path / ('entry_hook.exe' if os.name == 'nt' else 'entry_hook')
+    build = subprocess.run(
+        [compiler, '-std=c11', '-O1', '-I', str(_REPO / 'runner' / 'src'),
+         str(c_file), '-o', str(exe)], capture_output=True, text=True)
+    assert build.returncode == 0, build.stdout + build.stderr
+    run = subprocess.run([str(exe)], capture_output=True, text=True)
+    assert run.returncode == 0, run.stdout + run.stderr
+    assert run.stdout.strip() == 'ok'
+
+
+def test_program_emission_hooks_every_body_and_mirror(tmp_path):
+    """Through v2_emit: the routine's own body, a body that falls into the
+    hooked instruction, and the LoROM mirror bodies all carry the call."""
+    import re
+    import sys
+    from _helpers import make_lorom_bank0
+    # Root  $8000: JSR $8100 / JSR $80F0 / JML $80:8100
+    # Sub   $8100: INC $40 / RTS             (hooked)
+    # Lead  $80F0: LDA #$01 / STA $40 / falls into Sub
+    rom = bytearray(make_lorom_bank0({
+        0x8000: bytes.fromhex('20 00 81 20 F0 80 5C 00 81 80'),
+        0x80F0: bytes.fromhex('A9 01 85 40') + bytes([0xEA] * 12),
+        0x8100: bytes.fromhex('E6 40 60'),
+    }))
+    rom[0x7FFC:0x7FFE] = bytes([0x00, 0x80])
+    (tmp_path / 'game.sfc').write_bytes(bytes(rom))
+    cfg_dir = tmp_path / 'recomp'
+    cfg_dir.mkdir()
+    (cfg_dir / 'bank00.cfg').write_text('\n'.join([
+        'bank = 00',
+        'func I_RESET 8000 end:800a entry_mx:1,1',
+        'func Lead 80f0 end:8103 entry_mx:1,1',
+        'func Sub 8100 end:8103 entry_mx:1,1',
+        'entry_hook 8100 HostSaw',
+    ]) + '\n', encoding='utf-8')
+    out_dir = tmp_path / 'gen'
+    result = subprocess.run([
+        sys.executable, str(_REPO / 'tools' / 'v2_emit.py'),
+        '--rom', str(tmp_path / 'game.sfc'), '--cfg-dir', str(cfg_dir),
+        '--out-dir', str(out_dir), '--no-host-root-scan',
+    ], text=True, capture_output=True)
+    assert result.returncode == 0, result.stdout + result.stderr
+    hooked = {}
+    for path in sorted(out_dir.glob('bank*_v2*.c')):
+        bank = int(path.name[4:6], 16)
+        text = path.read_text(encoding='utf-8')
+        for body in re.split(r'^RecompReturn ', text, flags=re.M)[1:]:
+            name = body.split('(', 1)[0]
+            blocks = re.split(r'^  (L_[0-9A-F]{4}_M[01]X[01]):', body,
+                              flags=re.M)
+            for label, block in zip(blocks[1::2], blocks[2::2]):
+                if label.startswith('L_8100_'):
+                    call = f'HostSaw(cpu, 0x{bank:02X}8100u);'
+                    assert block.count(call) == 1, (path.name, name, label)
+                    hooked.setdefault(bank, set()).add(name.split('_M')[0])
+    assert {'Sub', 'Lead'} <= hooked[0x00]
+    assert 0x80 in hooked                  # the JML $80:8100 mirror body
diff --git a/tests/v2/test_hle_guard_func.py b/tests/v2/test_hle_guard_func.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7b3f99087c51114ba4c51e05c48bc0d74caf596
--- /dev/null
+++ b/tests/v2/test_hle_guard_func.py
@@ -0,0 +1,88 @@
+"""Guarded HLE retains native fallback and exact invocation context."""
+import ast, json, os, pathlib, shutil, subprocess, sys, tempfile, unittest
+ROOT=pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/'recompiler'))
+from v2.cfg_loader import load_bank_cfg
+from v2.emit_function import emit_function
+
+class GuardTests(unittest.TestCase):
+ def test_cfg_refusals(self):
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td)/'bank00.cfg'
+   p.write_text('bank = 00\nforce_lle_variant 0084E9:M1X1\nhle_guard_func 8000 TryGuard\n')
+   cfg=load_bank_cfg(str(p));self.assertEqual(cfg.hle_guard_func,{0x8000:'TryGuard'});self.assertFalse(cfg.entries);self.assertFalse(cfg.hle_func)
+   for directive in ['hle_guard_func 8000','hle_guard_func 8000 bad-name','hle_guard_func 10000 TryGuard','hle_guard_func 8000 TryGuard extra','hle_guard_func 8000 TryGuard\nhle_guard_func 8000 Again','hle_guard_func 8000 TryGuard\nhle_func 8000 Replaced']:
+    p.write_text('bank = 00\n'+directive+'\n')
+    with self.assertRaises(ValueError):load_bank_cfg(str(p))
+
+ def test_actual_emitted_false_true_context_and_deadline(self):
+  rom=bytearray([255]*32768);rom[:2]=bytes([0xea,0x60])
+  old=emit_function(bytes(rom),0,0x8000,1,0,func_name='Guarded')
+  guarded=emit_function(bytes(rom),0,0x8000,1,0,func_name='Guarded',hle_guard_func={0x8000:'TryGuard'})
+  self.assertIn('/* NOP */',guarded)
+  self.assertLess(guarded.index('WatchdogCheck();'),guarded.index('if (TryGuard('))
+  self.assertLess(guarded.index('if (TryGuard('),guarded.index('cpu->cycles +='))
+  self.assertNotIn('TryGuard',old)
+  tree=ast.parse((ROOT/'tests/v2/test_hle_func_seam.py').read_text())
+  harness=next(ast.literal_eval(node.value) for node in tree.body if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='_HARNESS' for t in node.targets))
+  harness=harness.split('/* The C helpers.')[0]
+  harness=harness.replace('uint8 g_ram[0x20000];','static int watches,pops,yields,deadline; uint8 g_ram[0x20000];')
+  harness=harness.replace('void WatchdogCheck(void) {}','void WatchdogCheck(void) {watches++;}')
+  harness=harness.replace('void RecompStackPop(void) { g_recomp_stack_top--; }','void RecompStackPop(void) { pops++;g_recomp_stack_top--; }')
+  harness=harness.replace('void RecompStackPopYield(void) { g_recomp_stack_top--; }','void RecompStackPopYield(void) { yields++;g_recomp_stack_top--; }')
+  harness=harness.replace('(void)cpu; return 0;\n}\nint interp_bridge_return_targets_owner', '(void)cpu; return deadline;\n}\nint interp_bridge_return_targets_owner')
+  harness+='\n#include <assert.h>\nstatic int pending; int interp_bridge_lle_unwind_pending(void){return pending;}\nstatic int mode,calls;static uint16 seen_s;static uint8 seen_hrv;static uint32 seen_pc;\n'
+  harness+='bool TryGuard(CpuState*c,uint16_t s,uint8_t h,uint32_t pc,RecompReturn*out){assert(watches);calls++;seen_s=s;seen_hrv=h;seen_pc=pc;if(!mode)return false;c->A=0xbeef;c->S=(uint16)(s+h);*out=mode==2?RECOMP_RETURN_LLE_UNWIND_BASE:(mode==3?RECOMP_RETURN_LLE_UNWIND_BASE-1:RECOMP_RETURN_NORMAL);return true;}\n'
+  harness+=old.replace('Guarded_M1X0','Original_M1X0')+guarded
+  harness+=r"""
+int main(void){
+ CpuState a={0},b; a.S=0x1fd;a.host_return_valid=2;a.PB=0;a.m_flag=1;a.ram=g_ram;
+ g_ram[0x1fe]=0x33;g_ram[0x1ff]=0x81;b=a;
+ RecompReturn ra=Original_M1X0(&a);mode=0;RecompReturn rb=Guarded_M1X0(&b);
+ assert(ra==rb && !memcmp(&a,&b,sizeof(a)));assert(calls==1 && !g_recomp_stack_top);
+ b=a;b.S=0x1fd;b.cycles=0;b.master_cycles=0;mode=1;
+ Guarded_M1X0(&b);assert(b.A==0xbeef && b.S==0x1ff && b.cycles==0 && b.master_cycles==0);
+ assert(seen_s==0x1fd && seen_hrv==2 && seen_pc==0x8134);
+ b.S=0x1fb;g_ram[0x1fc]=0x44;g_ram[0x1fd]=0x92;g_ram[0x1fe]=0x01;
+ cpu_tailcall_inherit_return_context(0x1fb,3);Guarded_M1X0(&b);
+ assert(seen_s==0x1fb && seen_hrv==3 && seen_pc==0x019245 && !g_tc_valid);
+ int before=calls;deadline=1;Guarded_M1X0(&b);assert(calls==before);deadline=0;
+ mode=2;int yp=yields;Guarded_M1X0(&b);assert(yields==yp+1 && !g_recomp_stack_top);
+ mode=3;pending=1;yp=yields;Guarded_M1X0(&b);assert(yields==yp+1 && !g_recomp_stack_top);
+ puts("actual emitted guarded HLE false/true/tail-context/deadline/unwind PASS");return 0;
+}
+"""
+  compiler=shutil.which('clang') or shutil.which('gcc')
+  if not compiler:self.skipTest('C compiler required')
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td);(p/'test.c').write_text(harness);exe=p/('test.exe' if os.name=='nt' else 'test')
+   subprocess.run([compiler,'-std=c11','-O1','-I',str(ROOT/'runner/src'),str(p/'test.c'),'-o',str(exe)],check=True)
+   subprocess.run([str(exe)],check=True)
+
+ def test_generation_identity_modes_and_no_hle(self):
+  with tempfile.TemporaryDirectory() as td:
+   p=pathlib.Path(td);rom=bytearray([255]*32768);rom[:2]=bytes([0xea,0x60]);rom[0x7ffc:0x7ffe]=bytes([0,128]);(p/'rom.sfc').write_bytes(rom)
+   cfg=p/'cfg';cfg.mkdir();cf=cfg/'bank00.cfg'
+   base='bank = 00\nfunc Guarded 8000 end:8002 entry_mx:1,0\n'
+   def generate(name,directive='',extra=()):
+    cf.write_text(base+directive)
+    out=p/name
+    proc=subprocess.run([sys.executable,str(ROOT/'tools/v2_emit.py'),'--rom',str(p/'rom.sfc'),'--cfg-dir',str(cfg),'--out-dir',str(out),'--no-host-root-scan',*extra],capture_output=True,text=True)
+    self.assertEqual(proc.returncode,0,proc.stdout+proc.stderr)
+    return out,json.loads((out/'program_manifest.json').read_text())
+   old,manifest=generate('old')
+   new,guarded=generate('new','hle_guard_func 8000 TryGuard\n')
+   self.assertEqual(guarded.pop('hle_guards'),[{'pc24':0x8000,'handler':'TryGuard','modes':[[1,1]]}])
+   self.assertEqual(manifest,guarded)
+   disabled,off=generate('off','hle_guard_func 8000 TryGuard\n',('--no-hle',))
+   self.assertEqual(off,manifest)
+   for file in old.glob('bank*_v2.c'):
+    self.assertEqual(file.read_bytes(),(disabled/file.name).read_bytes())
+   roots=p/'roots.txt';roots.write_text('808000:M1X1\n')
+   mirrored,mirror_manifest=generate('mirror','hle_guard_func 8000 TryGuard\n',('--analysis-roots-file',str(roots)))
+   self.assertEqual([row['pc24'] for row in mirror_manifest['hle_guards']],[0x8000,0x808000])
+   other,othermanifest=generate('other','hle_guard_func 8000 TryOther\n')
+   self.assertNotEqual((new/'program_manifest.json').read_bytes(),(other/'program_manifest.json').read_bytes())
+   self.assertNotEqual(json.loads((new/'.snesrecomp-cache.json').read_text())['config_digest'],json.loads((other/'.snesrecomp-cache.json').read_text())['config_digest'])
+
+if __name__=='__main__':unittest.main()
